local ESP = {}

local function destroyESP(id)
    local entry = ESP[id]
    if not entry then return end
    if entry.Highlight then entry.Highlight:Destroy() end
    if entry.Billboard then entry.Billboard:Destroy() end
    ESP[id] = nil
end

local function destroyESPWithPrefix(prefix)
    local ids = {}
    for id in pairs(ESP) do
        if string.sub(id, 1, #prefix) == prefix then
            table.insert(ids, id)
        end
    end
    for _, id in ipairs(ids) do
        destroyESP(id)
    end
end

local function setESP(id, object, text, color)
    if not object or not object.Parent then
        destroyESP(id)
        return
    end

    local adornee = getAdornee(object)
    if not adornee then
        destroyESP(id)
        return
    end

    local entry = ESP[id]
    if entry and entry.Object ~= object then
        destroyESP(id)
        entry = nil
    end

    if not entry then
        local highlight = Instance.new("Highlight")
        highlight.Name = "GH_Highlight_" .. id
        highlight.FillTransparency = 0.62
        highlight.OutlineTransparency = 0
        highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
        highlight.Adornee = (object:IsA("Model") or object:IsA("BasePart")) and object or adornee
        highlight.Parent = ESPContainer

        local billboard = Instance.new("BillboardGui")
        billboard.Name = "GH_Label_" .. id
        billboard.Size = UDim2.fromOffset(190, 28)
        billboard.StudsOffset = Vector3.new(0, 3, 0)
        billboard.AlwaysOnTop = true
        billboard.MaxDistance = 1500
        billboard.Adornee = adornee
        billboard.Parent = ESPContainer

        local label = Instance.new("TextLabel")
        label.Name = "Text"
        label.Size = UDim2.fromScale(1, 1)
        label.BackgroundTransparency = 1
        label.Font = Enum.Font.GothamBold
        label.TextScaled = true
        label.TextStrokeTransparency = 0
        label.TextStrokeColor3 = Color3.new(0, 0, 0)
        label.Parent = billboard

        entry = {
            Object = object,
            Highlight = highlight,
            Billboard = billboard,
            Label = label
        }
        ESP[id] = entry
    end

    entry.Highlight.FillColor = color
    entry.Highlight.OutlineColor = color
    entry.Billboard.Adornee = adornee
    entry.Label.Text = text
    entry.Label.TextColor3 = color
end

