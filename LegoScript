local evidenceCollapsed = false local speedCollapsed = false
local function layoutOverlay()
    Camera = workspace.CurrentCamera
    local viewport = Camera and Camera.ViewportSize or Vector2.new(1280, 720)
    local mobile = UserInputService.TouchEnabled or viewport.X < 760
    local scale = mobile and 0.9 or 1
    local width = mobile and math.clamp(math.floor(viewport.X * 0.44), 165, 220) or 220
    local speedWidth = mobile and math.clamp(math.floor(viewport.X * 0.44), 165, 210) or 210
    EvidenceScale.Scale = scale SpeedScale.Scale = scale
    EvidenceFrame.Size = UDim2.fromOffset(width, evidenceCollapsed and 38 or 336)
    SpeedFrame.Size = UDim2.fromOffset(speedWidth, speedCollapsed and 38 or 182)
    if mobile then
        EvidenceFrame.Position = UDim2.fromOffset(viewport.X - width * scale - 8, 8)
        SpeedFrame.Position = UDim2.fromOffset(viewport.X - speedWidth * scale - 8, 8 + (evidenceCollapsed and 44 or 198))
    else
        EvidenceFrame.Position = UDim2.fromOffset(viewport.X - width - 20, 20)
        SpeedFrame.Position = UDim2.fromOffset(viewport.X - speedWidth - 20, 264)
    end
    clampOverlay(EvidenceFrame) clampOverlay(SpeedFrame)
end
