-- ==================== ESP SYSTEM ====================
local function GetPosition(obj)
    if not obj then return nil end
    if obj:IsA("BasePart") then return obj.Position end
    if obj:IsA("Model") then
        if obj.PrimaryPart then return obj.PrimaryPart.Position end
        local part = obj:FindFirstChildWhichIsA("BasePart")
        if part then return part.Position end
        local ok, pos = pcall(function() return obj:GetPivot().Position end)
        if ok then return pos end
    end
    return nil
end

local function AddESP(parent, name, color)
    if not parent then return end
    if parent:FindFirstChild("NOTHING_ESP_"..name) then return end
    local pos = GetPosition(parent)
    if not pos then return end
    local folder = Instance.new("Folder")
    folder.Name = "NOTHING_ESP_"..name
    folder.Parent = parent
    local highlight = Instance.new("Highlight")
    highlight.FillColor = color
    highlight.OutlineColor = Color3.fromRGB(255, 255, 255)
    highlight.FillTransparency = 0.5
    highlight.OutlineTransparency = 0
    highlight.Adornee = parent:IsA("Model") and parent or (parent:IsA("BasePart") and parent or nil)
    highlight.Parent = folder
    local billboard = Instance.new("BillboardGui")
    billboard.Size = UDim2.new(0, 200, 0, 30)
    billboard.AlwaysOnTop = true
    billboard.StudsOffset = Vector3.new(0, 3, 0)
    billboard.Adornee = parent:IsA("BasePart") and parent or (parent.PrimaryPart or parent:FindFirstChildWhichIsA("BasePart"))
    if not billboard.Adornee then billboard.ExtentsOffsetWorldSpace = pos end
    billboard.Parent = folder
    local label = Instance.new("TextLabel")
    label.Size = UDim2.new(1, 0, 1, 0)
    label.BackgroundTransparency = 1
    label.TextColor3 = color
    label.TextStrokeColor3 = Color3.fromRGB(0, 0, 0)
    label.TextStrokeTransparency = 0
    label.Text = "..."
    label.Font = Enum.Font.GothamBold
    label.TextScaled = true
    label.Parent = billboard
end

local function UpdateESPText(parent, name, newText)
    if not parent then return end
    local folder = parent:FindFirstChild("NOTHING_ESP_"..name)
    if folder then
        local billboard = folder:FindFirstChildWhichIsA("BillboardGui")
        if billboard then
            local label = billboard:FindFirstChildWhichIsA("TextLabel")
            if label and label.Text ~= newText then label.Text = newText end
            if not billboard.Adornee then
                local pos = GetPosition(parent)
                if pos then billboard.ExtentsOffsetWorldSpace = pos end
            end
        end
    end
end

local function RemoveESP(parent, name)
    if not parent then return end
    local esp = parent:FindFirstChild("NOTHING_ESP_"..name)
    if esp then esp:Destroy() end
end

local function GetRoomFromPosition(pos)
    if not pos then return "Unknown" end
    local closestDist, closestRoom = math.huge, "Unknown"
    pcall(function()
        for _, zone in pairs(workspace.Map.Zones:GetChildren()) do
            local zonePos = GetPosition(zone)
            if zonePos then
                local dist = (pos - zonePos).Magnitude
                if dist < closestDist then closestDist=dist; closestRoom=zone.Name end
            end
        end
    end)
    return closestRoom
end

-- ==================== แก้บัค Music Box: หาแบบ Safe ====================
-- ค้นหา object ที่ชื่อตรงหรือใกล้เคียง ใน container ที่กำหนด
local function FindItemSafe(container, names)
    if not container then return nil end
    for _, name in ipairs(names) do
        local found = container:FindFirstChild(name)
        if found then return found end
    end
    -- fallback: ค้น descendant แบบ case-insensitive ชื่อใกล้เคียง
    for _, name in ipairs(names) do
        local lowerName = name:lower():gsub("%s","")
        for _, child in ipairs(container:GetDescendants()) do
            local childLower = child.Name:lower():gsub("%s","")
            if childLower == lowerName then return child end
        end
    end
    return nil
end

-- ==================== MAIN LOOP ====================
task.spawn(function()
    local ghostAlerted, slsAlerted, orbAlerted = false, false, false
    local writingAlerted, emf5Alerted, freezeAlerted = false, false, false
    local uvAlerted, saltAlerted = false, false

    -- ติดตาม object ที่ ESP อยู่ เพื่อ cleanup เมื่อหายไป
    local trackedCurseObjects = {}

    while true do
        task.wait(0.3)

        local lpChar = LocalPlayer.Character
        local lpRoot = lpChar and lpChar:FindFirstChild("HumanoidRootPart")
        local myPos  = lpRoot and lpRoot.Position or Vector3.new(0,0,0)

        -- Fullbright
        if Config.Fullbright then
            if Lighting.Brightness    ~= 2                             then Lighting.Brightness    = 2                             end
            if Lighting.ClockTime     ~= 14                            then Lighting.ClockTime     = 14                            end
            if Lighting.FogEnd        ~= 100000                        then Lighting.FogEnd        = 100000                        end
            if Lighting.GlobalShadows ~= false                         then Lighting.GlobalShadows = false                         end
            if Lighting.Ambient       ~= Color3.fromRGB(178,178,178)   then Lighting.Ambient       = Color3.fromRGB(178,178,178)   end
        end

        -- ==================== GHOST SPEED TRACKER ====================
        local ghost = workspace:FindFirstChild("Ghost")
        if ghost then
            local ghostPos = GetPosition(ghost)
            local now = tick()
            if ghostPos and ghostPrevPos and ghostPrevTime then
                local dt = now - ghostPrevTime
                if dt > 0.05 then -- กรอง noise
                    local speed = (ghostPos - ghostPrevPos).Magnitude / dt
                    -- เก็บ history
                    table.insert(ghostSpeedHistory, speed)
                    if #ghostSpeedHistory > MAX_HISTORY then
                        table.remove(ghostSpeedHistory, 1)
                    end
                    -- คำนวณค่าเฉลี่ยและสูงสุด
                    local total, maxSpd = 0, 0
                    for _, s in ipairs(ghostSpeedHistory) do
                        total = total + s
                        if s > maxSpd then maxSpd = s end
                    end
                    local avg = total / #ghostSpeedHistory
                    local category, catColor = GetSpeedCategory(speed)
                    -- อัปเดต GUI
                    SpeedValueLabel.Text = string.format("ความเร็ว: %.2f u/s", speed)
                    SpeedValueLabel.TextColor3 = catColor
                    SpeedStatusLabel.Text = category
                    SpeedStatusLabel.TextColor3 = catColor
                    SpeedAvgLabel.Text = string.format("เฉลี่ย: %.2f | สูงสุด: %.2f", avg, maxSpd)
                end
            end
            if ghostPos then
                ghostPrevPos  = ghostPos
                ghostPrevTime = now
            end
        else
            -- ผีหายไป: reset
            ghostPrevPos   = nil
            ghostPrevTime  = nil
            ghostSpeedHistory = {}
            SpeedValueLabel.Text    = "ความเร็ว: --"
            SpeedValueLabel.TextColor3 = Color3.fromRGB(200, 200, 200)
            SpeedStatusLabel.Text   = "สถานะ: รอผีปรากฏ"
            SpeedStatusLabel.TextColor3 = Color3.fromRGB(150, 150, 150)
            SpeedAvgLabel.Text      = "เฉลี่ย: -- | สูงสุด: --"
        end

        -- Player ESP
        if Config.PlayerESP then
            for _, player in pairs(Players:GetPlayers()) do
                if player ~= LocalPlayer and player.Character then
                    local char = player.Character
                    local shouldESP = (Config.SelectedPlayer == "All" or Config.SelectedPlayer == player.Name)
                    if shouldESP then
                        AddESP(char, "Player", Color3.fromRGB(0, 255, 0))
                        local pos  = GetPosition(char)
                        local dist = lpRoot and pos and math.floor((myPos-pos).Magnitude) or "?"
                        UpdateESPText(char, "Player", "👤 ["..dist.."m] "..player.Name)
                    else RemoveESP(char, "Player") end
                end
            end
        else
            for _, player in pairs(Players:GetPlayers()) do
                if player.Character then RemoveESP(player.Character, "Player") end
            end
        end

        -- EMF Reader ESP
        local isEMF5Present = false
        local emfSuccess, emfItem = pcall(function() return workspace.Map.Items:FindFirstChild("EMF Reader") end)
        if emfSuccess and emfItem then
            local currentLevel = 0
            for i = 5, 1, -1 do
                local levelFolder = emfItem:FindFirstChild(tostring(i))
                if levelFolder then
                    for _, desc in pairs(levelFolder:GetDescendants()) do
                        if desc:IsA("BasePart") and desc.Material == Enum.Material.Neon then
                            currentLevel = i
                            if i == 5 then isEMF5Present = true end
                            break
                        end
                    end
                    if currentLevel > 0 then break end
                end
            end
            if Config.EMFReaderESP then
                if currentLevel > 0 then
                    local emfColor = currentLevel==5 and Color3.fromRGB(255,0,0) or (currentLevel>=3 and Color3.fromRGB(255,255,0) or Color3.fromRGB(0,255,0))
                    AddESP(emfItem, "EMF", emfColor)
                    local pos  = GetPosition(emfItem)
                    local dist = lpRoot and pos and math.floor((myPos-pos).Magnitude) or "?"
                    UpdateESPText(emfItem, "EMF", "📡 ["..dist.."m] EMF Lv."..currentLevel)
                else RemoveESP(emfItem, "EMF") end
            else RemoveESP(emfItem, "EMF") end
        end
        UpdateEvidence("EMF Level 5", isEMF5Present)
        if isEMF5Present and not emf5Alerted then
            Notification.new({Title="📡 เจอหลักฐาน!", Description="ตรวจพบ EMF Level 5", Duration=5}); emf5Alerted=true
        elseif not isEMF5Present then emf5Alerted=false end

        -- Generator ESP
        local genSuccess, generators = pcall(function() return workspace.Map.Generators:GetChildren() end)
        if Config.GeneratorESP and genSuccess then
            for _, gen in pairs(generators) do
                if gen:IsA("Model") or gen:IsA("BasePart") then
                    AddESP(gen, "Generator", Color3.fromRGB(255, 255, 0))
                    local pos  = GetPosition(gen)
                    local dist = lpRoot and pos and math.floor((myPos-pos).Magnitude) or "?"
                    UpdateESPText(gen, "Generator", "⚡ ["..dist.."m] Generator")
                end
            end
        elseif not Config.GeneratorESP and genSuccess then
            for _, gen in pairs(generators) do RemoveESP(gen, "Generator") end
        end

        -- Coldest Room ESP
        local zoneSuccess, zones = pcall(function() return workspace.Map.Zones:GetChildren() end)
        local isFreezing = false
        if zoneSuccess then
            local coldestTemp, coldestRoom = math.huge, nil
            for _, zone in pairs(zones) do
                for _, child in pairs(zone:GetChildren()) do
                    if child.Name:find("Temperature") and child:IsA("NumberValue") then
                        if child.Value < 0 then isFreezing = true end
                        if child.Value < coldestTemp then coldestTemp=child.Value; coldestRoom=zone end
                    end
                end
            end
            if Config.ColdestRoomESP and coldestRoom then
                local freezeColor = coldestTemp < 0 and Color3.fromRGB(0,255,255) or Color3.fromRGB(0,200,255)
                AddESP(coldestRoom, "ColdRoom", freezeColor)
                local pos  = GetPosition(coldestRoom)
                local dist = lpRoot and pos and math.floor((myPos-pos).Magnitude) or "?"
                UpdateESPText(coldestRoom, "ColdRoom", "❄️ ["..dist.."m] "..coldestRoom.Name.." ("..string.format("%.1f",coldestTemp).."°)")
            elseif not Config.ColdestRoomESP then
                for _, zone in pairs(zones) do RemoveESP(zone, "ColdRoom") end
            end
        end
        UpdateEvidence("Freezing Temp", isFreezing)
        if isFreezing and not freezeAlerted then
            Notification.new({Title="🥶 เจอหลักฐาน!", Description="ตรวจพบ Freezing Temperature", Duration=5}); freezeAlerted=true
        elseif not isFreezing then freezeAlerted=false end

        -- Ghost ESP
        if Config.GhostESP and ghost then
            AddESP(ghost, "Ghost", Color3.fromRGB(255, 50, 50))
            local pos  = GetPosition(ghost)
            local dist = lpRoot and pos and math.floor((myPos-pos).Magnitude) or "?"
            UpdateESPText(ghost, "Ghost", "👻 ["..dist.."m] GHOST!")
            if not ghostAlerted then
                Notification.new({Title="👻 ผีเกิดแล้ว!", Description="ระวัง! Ghost ปรากฏตัวแล้ว", Duration=5}); ghostAlerted=true
            end
        else
            if ghost then RemoveESP(ghost, "Ghost") end
            if not ghost then ghostAlerted=false end
        end

        -- SLS Ghost ESP
        local slsGhost     = workspace:FindFirstChild("SLS_GHOST")
        local isSLSVisible = slsGhost ~= nil
        if Config.SLSGhostESP and slsGhost then
            AddESP(slsGhost, "SLS", Color3.fromRGB(255, 150, 0))
            local pos  = GetPosition(slsGhost)
            local dist = lpRoot and pos and math.floor((myPos-pos).Magnitude) or "?"
            UpdateESPText(slsGhost, "SLS", "📷 ["..dist.."m] SLS GHOST!")
            if not slsAlerted then
                Notification.new({Title="📷 เจอผีผ่านกล้อง!", Description="SLS_GHOST ปรากฏตัวแล้ว", Duration=5}); slsAlerted=true
            end
        else
            if slsGhost then RemoveESP(slsGhost, "SLS") end
            if not slsGhost then slsAlerted=false end
        end
        UpdateEvidence("SLS Ghost", isSLSVisible)

        -- Ghost Orb ESP
        local orbFound = false
        pcall(function()
            local orbPart = workspace.Map.Orbs:FindFirstChild("OrbPart")
            if orbPart then
                orbFound = true
                local orbPos = GetPosition(orbPart)
                if Config.GhostOrbESP then
                    AddESP(orbPart, "Orb", Color3.fromRGB(200, 0, 255))
                    local dist     = lpRoot and orbPos and math.floor((myPos-orbPos).Magnitude) or "?"
                    local roomName = GetRoomFromPosition(orbPos)
                    UpdateESPText(orbPart, "Orb", "🔮 ["..dist.."m] Orb ("..roomName..")")
                else RemoveESP(orbPart, "Orb") end
            end
        end)
        UpdateEvidence("Ghost Orb", orbFound)
        if orbFound and not orbAlerted then
            Notification.new({Title="🔮 เจอหลักฐาน!", Description="ตรวจพบ Ghost Orb", Duration=5}); orbAlerted=true
        elseif not orbFound then orbAlerted=false end

        -- ==================== UV EVIDENCE (แก้บัคแล้ว) ====================
        local uvFound = false
        pcall(function()
            local prints = workspace.Map:FindFirstChild("Prints")
            if not prints then return end
            -- รอยเท้า
            if prints:FindFirstChild("UV_BootL") or prints:FindFirstChild("UV_BootR") then
                uvFound = true
            end
            -- รอยนิ้วมือ: UV_Hand อาจเป็น Folder มี children อยู่
            if not uvFound then
                local handFolder = prints:FindFirstChild("UV_Hand")
                if handFolder then
                    if handFolder:IsA("Folder") then
                        if #handFolder:GetChildren() > 0 then uvFound = true end
                    else
                        uvFound = true
                    end
                end
                -- หรืออาจเป็น descendant ใน prints ที่ชื่อขึ้นต้น UV_Hand
                if not uvFound then
                    for _, desc in ipairs(prints:GetDescendants()) do
                        if desc.Name:find("UV_Hand") then uvFound = true; break end
                    end
                end
            end
        end)
        UpdateEvidence("Ultraviolet", uvFound)
        if uvFound and not uvAlerted then
            Notification.new({Title="💡 เจอหลักฐาน!", Description="ตรวจพบ Ultraviolet (UV)", Duration=5}); uvAlerted=true
        elseif not uvFound then uvAlerted=false end

        -- Salt Stepped
        local saltStepped = false
        pcall(function() if workspace:FindFirstChild("SaltStepped") then saltStepped=true end end)
        UpdateEvidence("Salt Stepped", saltStepped)
        if saltStepped and not saltAlerted then
            Notification.new({Title="🧂 ผีเหยียบเกลือ!", Description="ผีเดินผ่านเกลือแล้ว", Duration=5}); saltAlerted=true
        elseif not saltStepped then saltAlerted=false end

        -- Ghost Writing
        local writingFound = false
        pcall(function()
            local book = workspace.Map.Items["Ghost Writing Book"]
            if book then
                local handle = book:FindFirstChild("Handle")
                if handle then
                    for _, child in pairs(handle:GetChildren()) do
                        if string.match(child.Name, "^Writing%d+$") then writingFound=true; break end
                    end
                end
            end
        end)
        UpdateEvidence("Ghost Writing", writingFound)
        if writingFound and not writingAlerted then
            Notification.new({Title="📝 เจอหลักฐาน!", Description="ตรวจพบ Ghost Writing", Duration=5}); writingAlerted=true
        elseif not writingFound then writingAlerted=false end

        -- ==================== CURSED ITEMS ESP (แก้บัค Music Box) ====================
        local curseDefs = {
            {Key="SummoningCircleESP", Name="Circle",     Names={"SummoningCircle","Summoning Circle"}, Icon="🔮", Color=Color3.fromRGB(170,0,255)},
            {Key="BooBooDollESP",      Name="BooBoo",     Names={"BooBooDoll","BooBoo Doll"},           Icon="🧸", Color=Color3.fromRGB(255,0,255)},
            -- แก้บัค: ค้นหา Music Box ทั้งสองรูปแบบ พร้อม validate ว่า object ยังอยู่ใน workspace จริงๆ
            {Key="MusicBoxESP",        Name="MusicBox",   Names={"Music Box"," Music Box","MusicBox"},  Icon="🎵", Color=Color3.fromRGB(255,200,0), containers={"Items","CursedSpawns"}},
            {Key="TarotCardsESP",      Name="Tarot",      Names={"Tarot Cards","TarotCards"},           Icon="🃏", Color=Color3.fromRGB(255,100,150)},
            {Key="SpiritBoardESP",     Name="SpiritBoard",Names={"Spirit Board","SpiritBoard"},         Icon="🟫", Color=Color3.fromRGB(200,200,200)},
        }

        for _, item in ipairs(curseDefs) do
            local obj = nil

            -- หา object
            pcall(function()
                if item.containers then
                    -- ค้นใน containers ที่ระบุ
                    for _, containerName in ipairs(item.containers) do
                        local container = workspace.Map:FindFirstChild(containerName)
                        if container then
                            obj = FindItemSafe(container, item.Names)
                            if obj then break end
                        end
                    end
                else
                    -- ค้นแบบ recursive ใน workspace.Map
                    for _, name in ipairs(item.Names) do
                        obj = workspace.Map:FindFirstChild(name, true)
                        if obj then break end
                    end
                end
            end)

            -- ==================== แก้บัคหลัก: ตรวจสอบว่า object ยังมีอยู่จริง ====================
            -- ถ้า obj เป็น nil หรือ Parent เป็น nil = object ถูกลบแล้ว ให้เอา ESP ออก
            local objValid = obj and obj.Parent ~= nil and obj:IsDescendantOf(workspace)

            -- ดึง tracked object เก่า (ถ้ามี) เพื่อ cleanup เมื่อ obj เปลี่ยน
            local prevObj = trackedCurseObjects[item.Name]
            if prevObj and prevObj ~= obj then
                -- object เปลี่ยนหรือหายไป ลบ ESP เก่า
                pcall(function() RemoveESP(prevObj, item.Name) end)
                trackedCurseObjects[item.Name] = nil
            end

            if Config[item.Key] and objValid then
                AddESP(obj, item.Name, item.Color)
                local pos  = GetPosition(obj)
                local dist = lpRoot and pos and math.floor((myPos-pos).Magnitude) or "?"
                UpdateESPText(obj, item.Name, item.Icon.." ["..dist.."m] "..item.Name)
                trackedCurseObjects[item.Name] = obj
            else
                -- ปิด config หรือ object ไม่มีแล้ว: ลบ ESP
                if objValid then RemoveESP(obj, item.Name) end
                trackedCurseObjects[item.Name] = nil
            end
        end

    end
end)

Notification.new({
    Title = "GHOST HUB",
