-- resolve container path
local function ResolveContainers(paths)
    local result = {}
    for _, path in ipairs(paths) do
        local cur = workspace
        for seg in path:gmatch("[^/]+") do
            cur = cur:FindFirstChild(seg)
            if not cur then break end
        end
        if cur then table.insert(result, cur) end
    end
    return result
end

-- track last found object per curse
local CurseTracked = {}

-- =====================================================
--  MAIN LOOP
-- =====================================================
task.spawn(function()
    local TICK = 0
    while true do
        task.wait(0.25)
        TICK = TICK + 1

        local char  = LocalPlayer.Character
        local root  = char and char:FindFirstChild("HumanoidRootPart")
        local myPos = root and root.Position or Vector3.zero

        -- ── Fullbright ──────────────────────────────
        if CFG.Fullbright then
            Lighting.Brightness    = 2
            Lighting.ClockTime     = 14
            Lighting.FogEnd        = 1e5
            Lighting.GlobalShadows = false
            Lighting.Ambient       = Color3.fromRGB(178,178,178)
        end

        -- ── Player ESP ──────────────────────────────
        for _, p in ipairs(Players:GetPlayers()) do
            if p == LocalPlayer then continue end
            local pc = p.Character
            if not pc then continue end
            local root2 = pc:FindFirstChild("HumanoidRootPart")
            local show = CFG.PlayerESP and (CFG.SelectedPlayer=="All" or CFG.SelectedPlayer==p.Name)
            if show then
                AddESP(pc, "Player", Color3.fromRGB(80,220,80))
                local d = root and root2 and math.floor((myPos-root2.Position).Magnitude) or 0
                -- มือถือ: ชื่อย่อ 8 ตัว + ระยะ
                local name = isMobile and p.Name:sub(1,8) or p.Name
                UpdateESP(pc, "Player", ("👤%s %dm"):format(name, d))
            else
                RemoveESP(pc, "Player")
            end
        end

        -- ── Ghost ESP + Speed ────────────────────────
        local ghost = workspace:FindFirstChild("Ghost")
        -- speed calc
        if ghost then
            local gpos = SafePos(ghost)
            local now  = tick()
            if gpos and spdPrevPos and spdPrevTime then
                local dt = now - spdPrevTime
                if dt >= 0.1 then
                    local spd = (gpos - spdPrevPos).Magnitude / dt
                    table.insert(spdHistory, spd)
                    if #spdHistory > SPD_MAX_HIST then table.remove(spdHistory,1) end
                    local tot, mx = 0, 0
                    for _, s in ipairs(spdHistory) do tot=tot+s; if s>mx then mx=s end end
                    local avg = tot/#spdHistory
                    local cat, col = SpeedCategory(spd)
                    SpdCurVal.Text  = ("%.1f u/s"):format(spd)
                    SpdCurVal.TextColor3 = col
                    SpdAvgVal.Text  = ("%.1f u/s"):format(avg)
                    SpdMaxVal.Text  = ("%.1f u/s"):format(mx)
                    SpdBadge.Text        = cat
                    SpdBadge.TextColor3  = col
                    spdPrevPos  = gpos
                    spdPrevTime = now
                end
            else
                spdPrevPos  = SafePos(ghost)
                spdPrevTime = tick()
            end
        else
            spdPrevPos=nil; spdPrevTime=nil; spdHistory={}
            SpdCurVal.Text="--"; SpdAvgVal.Text="--"; SpdMaxVal.Text="--"
            SpdBadge.Text="รอผีปรากฏ..."; SpdBadge.TextColor3=Color3.fromRGB(130,130,145)
            ClearAlert("ghost")
        end

        if CFG.GhostESP and ghost then
            AddESP(ghost,"Ghost",Color3.fromRGB(255,60,60))
            UpdateESP(ghost,"Ghost",("👻 %sm"):format(tostring(Dist(myPos,ghost))))
            Alert("ghost","👻 Ghost!","ผีปรากฏตัวแล้ว ระวัง!")
        elseif not ghost then RemoveESP(ghost,"Ghost") end

        -- ── SLS Ghost ───────────────────────────────
        local sls = workspace:FindFirstChild("SLS_GHOST")
        SetEvidence("SLS Ghost", sls ~= nil)
        if CFG.SLSESP and sls then
            AddESP(sls,"SLS",Color3.fromRGB(255,160,0))
            UpdateESP(sls,"SLS",("📷SLS %dm"):format(Dist(myPos,sls)))
            Alert("sls","📷 SLS Ghost!","ตรวจพบ SLS Ghost")
        else
            if sls then RemoveESP(sls,"SLS") end
            if not sls then ClearAlert("sls") end
        end

        -- ── EMF Reader ──────────────────────────────
        local isEMF5 = false
        pcall(function()
            local emf = workspace.Map.Items:FindFirstChild("EMF Reader")
            if not emf then return end
            local curLv = 0
            for i=5,1,-1 do
                local lf = emf:FindFirstChild(tostring(i))
                if lf then
                    for _, d in ipairs(lf:GetDescendants()) do
                        if d:IsA("BasePart") and d.Material==Enum.Material.Neon then
                            curLv=i; break
                        end
                    end
                    if curLv>0 then break end
                end
            end
            if curLv==5 then isEMF5=true end
            if CFG.EMFESP then
                if curLv>0 then
                    local c = curLv==5 and Color3.fromRGB(255,0,0)
                           or (curLv>=3 and Color3.fromRGB(255,220,0)
                           or Color3.fromRGB(0,220,100))
                    AddESP(emf,"EMF",c)
                    UpdateESP(emf,"EMF",("📡Lv%d %dm"):format(curLv,Dist(myPos,emf)))
                else RemoveESP(emf,"EMF") end
            else RemoveESP(emf,"EMF") end
        end)
        SetEvidence("EMF Level 5", isEMF5)
        if isEMF5 then Alert("emf5","📡 EMF Level 5","ตรวจพบ EMF Level 5")
        else ClearAlert("emf5") end

        -- ── Generator ───────────────────────────────
        pcall(function()
            for _, gen in ipairs(workspace.Map.Generators:GetChildren()) do
                if CFG.GeneratorESP then
                    AddESP(gen,"Gen",Color3.fromRGB(255,230,0))
                    UpdateESP(gen,"Gen",("⚡Gen %dm"):format(Dist(myPos,gen)))
                else RemoveESP(gen,"Gen") end
            end
        end)

        -- ── Coldest Room ────────────────────────────
        local isFreeze = false
        pcall(function()
            local coldT, coldZ = math.huge, nil
            for _, z in ipairs(workspace.Map.Zones:GetChildren()) do
                for _, c in ipairs(z:GetChildren()) do
                    if c:IsA("NumberValue") and c.Name:find("Temp") then
                        if c.Value < 0 then isFreeze=true end
                        if c.Value < coldT then coldT=c.Value; coldZ=z end
                    end
                end
            end
            if CFG.ColdRoomESP and coldZ then
                local col = coldT<0 and Color3.fromRGB(0,230,230) or Color3.fromRGB(0,180,255)
                AddESP(coldZ,"Cold",col)
                UpdateESP(coldZ,"Cold",("❄%s %.0f°"):format(coldZ.Name:sub(1,6), coldT))
            elseif not CFG.ColdRoomESP then
                for _, z in ipairs(workspace.Map.Zones:GetChildren()) do
                    RemoveESP(z,"Cold")
                end
            end
        end)
        SetEvidence("Freezing Temp", isFreeze)
        if isFreeze then Alert("freeze","🥶 Freezing Temp","ตรวจพบห้องอุณหภูมิต่ำ")
        else ClearAlert("freeze") end

        -- ── Ghost Orb ───────────────────────────────
        local orbFound = false
        pcall(function()
            local orb = workspace.Map.Orbs:FindFirstChild("OrbPart")
            if orb then
                orbFound=true
                if CFG.OrbESP then
                    AddESP(orb,"Orb",Color3.fromRGB(180,0,255))
                    UpdateESP(orb,"Orb",("🔮Orb %dm"):format(Dist(myPos,orb)))
                else RemoveESP(orb,"Orb") end
            end
        end)
        SetEvidence("Ghost Orb", orbFound)
        if orbFound then Alert("orb","🔮 Ghost Orb","ตรวจพบ Ghost Orb")
        else ClearAlert("orb") end

        -- ── Ultraviolet ─────────────────────────────
        local uvFound = false
        pcall(function()
            local prints = workspace.Map:FindFirstChild("Prints")
            if not prints then return end
            if prints:FindFirstChild("UV_BootL") or prints:FindFirstChild("UV_BootR") then
                uvFound=true
            end
            if not uvFound then
                local hf = prints:FindFirstChild("UV_Hand")
                if hf then
                    uvFound = not hf:IsA("Folder") or #hf:GetChildren()>0
                end
            end
            if not uvFound then
                for _, d in ipairs(prints:GetDescendants()) do
                    if d.Name:find("UV_") then uvFound=true; break end
                end
            end
        end)
        SetEvidence("Ultraviolet", uvFound)
        if uvFound then Alert("uv","💡 Ultraviolet","ตรวจพบ UV (รอยเท้า/นิ้วมือ)")
        else ClearAlert("uv") end

        -- ── Salt Stepped ────────────────────────────
        local salt = workspace:FindFirstChild("SaltStepped") ~= nil
        SetEvidence("Salt Stepped", salt)
        if salt then Alert("salt","🧂 Salt!","ผีเหยียบเกลือแล้ว")
        else ClearAlert("salt") end

        -- ── Ghost Writing ───────────────────────────
        local writing = false
        pcall(function()
            local book = workspace.Map.Items["Ghost Writing Book"]
            if not book then return end
            local h = book:FindFirstChild("Handle")
            if not h then return end
            for _, c in ipairs(h:GetChildren()) do
                if c.Name:match("^Writing%d+$") then writing=true; break end
            end
        end)
        SetEvidence("Ghost Writing", writing)
        if writing then Alert("write","📝 Ghost Writing","ตรวจพบการเขียนของผี")
        else ClearAlert("write") end

        -- ── Cursed Items ESP ────────────────────────
        for _, def in ipairs(CurseDefs) do
            local conts = ResolveContainers(def.containers)
            local obj   = FindSafe(conts, def.names)
            local valid = obj and obj.Parent and obj:IsDescendantOf(workspace)

            -- cleanup เมื่อ object เปลี่ยน/หาย
            local prev = CurseTracked[def.id]
            if prev and prev ~= obj then
                pcall(function() RemoveESP(prev, def.id) end)
                CurseTracked[def.id] = nil
            end

            if CFG[def.key] and valid then
                AddESP(obj, def.id, def.color)
                UpdateESP(obj, def.id, ("%s%s %dm"):format(def.icon, def.id, Dist(myPos,obj)))
                CurseTracked[def.id] = obj
            else
                if valid then RemoveESP(obj, def.id) end
                CurseTracked[def.id] = nil
            end
        end

    end -- while
end)

