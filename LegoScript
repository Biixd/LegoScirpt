                pcall(function()
                    obj = workspace.Map.Items:FindFirstChild(" Music Box")
                    -- fallback ถ้าไม่เจอ ลอง "Music Box" ปกติ
                    if not obj then obj = workspace.Map.Items:FindFirstChild("Music Box") end
