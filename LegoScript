local function SetEvid(name, found)
    local s = EvidState[name]
    if not s or s.found == found then return end
    s.found = found
    if found then
        s.dot.TextColor3 = Color3.fromRGB(50,210,90)
        s.dot.Text       = "✓"
        s.lbl.TextColor3 = Color3.fromRGB(180,240,190)
    else
        s.dot.TextColor3 = Color3.fromRGB(200,50,50)
        s.dot.Text       = "●"
        s.lbl.TextColor3 = Color3.fromRGB(160,160,175)
    end
end

