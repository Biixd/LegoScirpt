-- =====================================================
--  ESP CORE
-- =====================================================
local ESPCache = {}   -- [object] = { folder, billboard, label, highlight }

local function SafePos(obj)
    if not obj then return nil end
    local ok, result = pcall(function()
        if obj:IsA("BasePart") then return obj.Position end
        if obj:IsA("Model") then
            if obj.PrimaryPart then return obj.PrimaryPart.Position end
            local p = obj:FindFirstChildWhichIsA("BasePart")
            if p then return p.Position end
            return obj:GetPivot().Position
        end
    end)
    return ok and result or nil
end

local function SafeAdornee(obj)
    if not obj then return nil end
    if obj:IsA("BasePart") then return obj end
    if obj:IsA("Model") then
        return obj.PrimaryPart or obj:FindFirstChildWhichIsA("BasePart")
    end
    return nil
end

local function AddESP(obj, id, color)
    if not obj or not obj.Parent then return end
    local key = tostring(obj) .. id
    if ESPCache[key] then return end

    local pos = SafePos(obj)
    if not pos then return end

    -- folder cleanup on destroy
    local folder = Instance.new("Folder")
    folder.Name = "__ESP_" .. id
    folder.Parent = obj

    -- highlight
    local hl = Instance.new("Highlight")
    hl.FillColor          = color
    hl.OutlineColor       = Color3.fromRGB(255,255,255)
    hl.FillTransparency   = 0.6
    hl.OutlineTransparency = 0.1
    hl.Adornee            = obj:IsA("Model") and obj or (obj:IsA("BasePart") and obj or nil)
    hl.Parent             = folder

    -- billboard  — ขนาดเล็กลงสำหรับมือถือ
    local bb = Instance.new("BillboardGui")
    bb.AlwaysOnTop        = true
    bb.Size               = isMobile and UDim2.new(0,110,0,22) or UDim2.new(0,140,0,22)
    bb.StudsOffset        = Vector3.new(0, isMobile and 2.2 or 2.8, 0)
    bb.MaxDistance        = isMobile and 80 or 120
    bb.Adornee            = SafeAdornee(obj)
    if not bb.Adornee then bb.ExtentsOffsetWorldSpace = pos end
    bb.Parent             = folder

    -- background pill
    local bg = Instance.new("Frame", bb)
    bg.Size                   = UDim2.new(1,0,1,0)
    bg.BackgroundColor3       = Color3.fromRGB(10,10,12)
    bg.BackgroundTransparency = 0.35
    bg.BorderSizePixel        = 0
    NewCorner(bg, 5)

    local lbl = Instance.new("TextLabel", bg)
    lbl.Size                  = UDim2.new(1,-6,1,0)
    lbl.Position              = UDim2.new(0,3,0,0)
    lbl.BackgroundTransparency= 1
    lbl.TextColor3            = color
    lbl.TextStrokeColor3      = Color3.fromRGB(0,0,0)
    lbl.TextStrokeTransparency= 0.4
    lbl.Font                  = Enum.Font.GothamBold
    -- ขนาด text มือถือเล็กลง
    lbl.TextSize              = isMobile and 10 or 11
    lbl.TextXAlignment        = Enum.TextXAlignment.Left
    lbl.TextTruncate          = Enum.TextTruncate.AtEnd
    lbl.Text                  = "..."

    ESPCache[key] = { folder=folder, lbl=lbl, hl=hl, bb=bb }

    -- auto cleanup
    folder.AncestryChanged:Connect(function()
        if not folder.Parent then
            ESPCache[key] = nil
        end
    end)
end

local function UpdateESP(obj, id, text)
    if not obj then return end
    local key = tostring(obj) .. id
    local c = ESPCache[key]
    if c and c.lbl and c.lbl.Parent then
        if c.lbl.Text ~= text then c.lbl.Text = text end
    end
end

local function RemoveESP(obj, id)
    if not obj then return end
    local key = tostring(obj) .. id
    local c = ESPCache[key]
    if c then
        pcall(function() c.folder:Destroy() end)
        ESPCache[key] = nil
    end
    -- cleanup folder ค้างใน object
    pcall(function()
        local f = obj:FindFirstChild("__ESP_"..id)
        if f then f:Destroy() end
    end)
end

local function Dist(myPos, obj)
    local p = SafePos(obj)
    if not p then return "0" end
    return math.floor((myPos - p).Magnitude)
end

-- =====================================================
--  FIND HELPER (Music Box safe)
-- =====================================================
local function FindSafe(containers, names)
    for _, cont in ipairs(containers) do
        if cont and cont.Parent then
            for _, n in ipairs(names) do
                local found = cont:FindFirstChild(n)
                if found then return found end
            end
            -- case-insensitive fallback
            for _, n in ipairs(names) do
                local lo = n:lower():gsub("%s","")
                for _, c in ipairs(cont:GetChildren()) do
                    if c.Name:lower():gsub("%s","") == lo then return c end
                end
            end
        end
    end
    return nil
end

