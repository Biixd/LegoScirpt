local SaltStepTimes = {}
local SaltStepCount = 0
local function saltTempoClass(dt)
    if dt > 6 then return "ผีเดินช้ามาก", Color3.fromRGB(120, 200, 255)
    elseif dt > 3.5 then return "ผีเดินช้า", Color3.fromRGB(100, 255, 130)
    elseif dt > 2 then return "ผีเดินปกติ", Color3.fromRGB(255, 210, 80)
    elseif dt > 1.1 then return "ผีเดินไว", Color3.fromRGB(255, 135, 70)
    else return "ผีวิ่งไว / hunting", Color3.fromRGB(255, 70, 70) end
end
local function recordSaltStep()
    local now = os.clock()
    SaltStepCount += 1
    local prev = SaltStepTimes[#SaltStepTimes]
    table.insert(SaltStepTimes, now)
    if #SaltStepTimes > 6 then table.remove(SaltStepTimes, 1) end
    if prev then
        local dt = now - prev
        local label, color = saltTempoClass(dt)
        SaltStepLabel.Text = string.format("Salt #%d: %.1fs (%s)", SaltStepCount, dt, label)
        SaltStepLabel.TextColor3 = color
        notify("ผีเหยียบเกลือ #" .. SaltStepCount, string.format("ห่าง %.1fs -> %s", dt, label), 5)
    else
        SaltStepLabel.Text = string.format("Salt #%d: ครั้งแรก", SaltStepCount)
        SaltStepLabel.TextColor3 = Colors.Good
        notify("ผีเหยียบเกลือ", "ครั้งแรกของรอบนี้ (จับจังหวะครั้งต่อไปเพื่อประเมินความเร็ว)", 5)
    end
end
local function countSaltStepped()
    local n = 0
    for _, c in ipairs(workspace:GetChildren()) do if c.Name == "SaltStepped" then n += 1 end end
    return n
end
local LastSaltCount = countSaltStepped()
local function updateSalt()
    local n = countSaltStepped()
    local found = n > 0
    if n > LastSaltCount then
        for _ = 1, (n - LastSaltCount) do recordSaltStep() end
    end
    LastSaltCount = n
    if SaltStepCount == 0 and n > 0 then SaltStepCount = n end
    if found and SaltStepLabel.Text == "Salt: --" then
        SaltStepLabel.Text = string.format("Salt x%d (เริ่มก่อนเปิดสคริปต์)", n)
    end
    updateEvidence("Salt Stepped", found)
    alertOnce("salt", found, "ผีเหยียบเกลือ", "ตรวจพบ SaltStepped")
end

-- FIXED Writing: Writings/WritingN Decal Transparency < 1 = written (live verified Transparency=1 blank)
local function isBookWritten(book)
    if not book then return false end
    local writings = book:FindFirstChild("Writings")
    if writings then
        for _, d in ipairs(writings:GetChildren()) do
            if d:IsA("Decal") and d.Transparency < 0.99 then return true end
        end
    end
    local handle = book:FindFirstChild("Handle")
    if handle then
        for _, object in ipairs(handle:GetChildren()) do
            if string.match(object.Name, "^Writing%d+$") then return true end
        end
        for _, d in ipairs(handle:GetDescendants()) do
            if d:IsA("Decal") and string.find(d.Name, "Writing") and d.Transparency < 0.99 then return true end
        end
    end
    return false
end
local function updateWriting()
    local found = false
    local mapObject = map()
    local items = mapObject and child(mapObject, "Items")
    local book = items and items:FindFirstChild("Ghost Writing Book")
    if book and isBookWritten(book) then found = true end
    if not found then
        for _, ch in ipairs(workspace:GetChildren()) do
            if ch:IsA("Model") and ch.Name ~= "Map" then
                local b = ch:FindFirstChild("Ghost Writing Book")
                if b and isBookWritten(b) then found = true break end
            end
        end
    end
    if not found and LocalPlayer.Character then
        local b = LocalPlayer.Character:FindFirstChild("Ghost Writing Book")
        if b and isBookWritten(b) then found = true end
    end
    updateEvidence("Ghost Writing", found)
    alertOnce("writing", found, "เจอหลักฐาน", "ตรวจพบ Ghost Writing")
end

