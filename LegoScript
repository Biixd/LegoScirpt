-- =====================================================
--  ESP CORE (เขียนใหม่ทั้งหมด)
--  วิธีใหม่: ไม่ใช้ cache key จาก pointer
--  แทน: ใส่ folder ตรงใน object แล้วอ่านกลับ
--  ทำให้ทนต่อ object respawn
-- =====================================================
local ESP_TAG = "GH_ESP_"

-- หา adornee ที่ใช้ได้จาก object
local function GetAdornee(obj)
    if not obj or not obj.Parent then return nil end
    if obj:IsA("BasePart") then return obj end
    if obj:IsA("Model") then
        -- ลอง PrimaryPart ก่อน
        if obj.PrimaryPart then return obj.PrimaryPart end
        -- หา HumanoidRootPart (player)
        local hrp = obj:FindFirstChild("HumanoidRootPart")
        if hrp then return hrp end
        -- หา BasePart ใดก็ได้
        local bp = obj:FindFirstChildWhichIsA("BasePart", true)
        if bp then return bp end
    end
    return nil
end

-- หา position จาก object
local function GetPos(obj)
    if not obj or not obj.Parent then return nil end
    local ok, result = pcall(function()
        if obj:IsA("BasePart") then return obj.Position end
        if obj:IsA("Model") then
            if obj.PrimaryPart then return obj.PrimaryPart.Position end
            local hrp = obj:FindFirstChild("HumanoidRootPart")
            if hrp then return hrp.Position end
            local bp = obj:FindFirstChildWhichIsA("BasePart", true)
            if bp then return bp.Position end
            return obj:GetPivot().Position
        end
        return nil
    end)
    return ok and result or nil
end

-- คำนวณระยะ คืนเป็น string เสมอ
local function GetDist(myPos, obj)
    local p = GetPos(obj)
    if not p then return "?" end
    return tostring(math.floor((myPos - p).Magnitude))
end

-- เพิ่ม ESP ให้ object
local function AddESP(obj, tag, color)
    -- ตรวจ object valid
    if not obj or not obj.Parent then return false end
    -- ถ้ามี ESP อยู่แล้วไม่ต้องทำซ้ำ
    if obj:FindFirstChild(ESP_TAG .. tag) then return true end

    local adornee = GetAdornee(obj)
    if not adornee then return false end

    -- สร้าง folder เก็บ ESP components
    local folder = Instance.new("Folder")
    folder.Name = ESP_TAG .. tag
    folder.Parent = obj

    -- Highlight — ไม่ set Adornee ตรงๆ ให้ parent เป็น obj แทน
    -- วิธีนี้ทำงานได้กับทั้ง Model และ BasePart
    local hl = Instance.new("Highlight")
    hl.Name               = "HL"
    hl.FillColor          = color
    hl.OutlineColor       = Color3.fromRGB(255, 255, 255)
    hl.FillTransparency   = 0.55
    hl.OutlineTransparency = 0
    -- สำคัญมาก: Adornee ต้องเป็น Model หรือ BasePart ที่ valid
    hl.Adornee            = adornee:IsA("BasePart") and adornee.Parent or adornee
    -- ถ้า adornee.Parent เป็น Model ให้ใช้ Model
    if adornee.Parent and adornee.Parent:IsA("Model") then
        hl.Adornee = adornee.Parent
    end
    hl.Parent             = folder

    -- BillboardGui
    local bb = Instance.new("BillboardGui")
    bb.Name           = "BB"
    bb.AlwaysOnTop    = true
    bb.Size           = isMobile and UDim2.new(0,120,0,24) or UDim2.new(0,150,0,24)
    bb.StudsOffset    = Vector3.new(0, isMobile and 2.5 or 3.5, 0)
    bb.MaxDistance    = 300  -- มองเห็นได้ไกล 300 studs
    bb.Adornee        = adornee
    bb.Parent         = folder

    -- พื้นหลัง label
    local bg = Instance.new("Frame", bb)
    bg.Size                   = UDim2.new(1,0,1,0)
    bg.BackgroundColor3       = Color3.fromRGB(8, 8, 10)
    bg.BackgroundTransparency = 0.3
    bg.BorderSizePixel        = 0
    local c = Instance.new("UICorner", bg)
    c.CornerRadius            = UDim.new(0, 4)

    -- Label
    local lbl = Instance.new("TextLabel", bg)
    lbl.Name                  = "LBL"
    lbl.Size                  = UDim2.new(1,-4,1,0)
    lbl.Position              = UDim2.new(0,2,0,0)
    lbl.BackgroundTransparency = 1
    lbl.TextColor3            = color
    lbl.TextStrokeColor3      = Color3.fromRGB(0,0,0)
    lbl.TextStrokeTransparency = 0.3
    lbl.Font                  = Enum.Font.GothamBold
    lbl.TextSize              = isMobile and 11 or 12
    lbl.TextXAlignment        = Enum.TextXAlignment.Left
    lbl.TextTruncate          = Enum.TextTruncate.AtEnd
    lbl.Text                  = "..."

    return true
end

-- อัปเดต text
local function UpdateESP(obj, tag, text)
    if not obj then return end
    local folder = obj:FindFirstChild(ESP_TAG .. tag)
    if not folder then return end
    local bb = folder:FindFirstChild("BB")
    if not bb then return end
    local bg = bb:FindFirstChildWhichIsA("Frame")
    if not bg then return end
    local lbl = bg:FindFirstChild("LBL")
    if lbl and lbl.Text ~= text then
        lbl.Text = text
    end
end

-- ลบ ESP
local function RemoveESP(obj, tag)
    if not obj then return end
    local folder = obj:FindFirstChild(ESP_TAG .. tag)
    if folder then
        pcall(function() folder:Destroy() end)
    end
end

-- ลบ ESP ทั้งหมดใน object
local function RemoveAllESP(obj)
    if not obj then return end
    for _, child in ipairs(obj:GetChildren()) do
        if child.Name:sub(1, #ESP_TAG) == ESP_TAG then
            pcall(function() child:Destroy() end)
        end
    end
end

