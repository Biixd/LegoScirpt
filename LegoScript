local function MakeDraggable(frame, handle)
    local drag, ds, sp = false, nil, nil
    handle.InputBegan:Connect(function(i)
        if i.UserInputType == Enum.UserInputType.MouseButton1
        or i.UserInputType == Enum.UserInputType.Touch then
            drag=true; ds=i.Position; sp=frame.Position
        end
    end)
    UIS.InputChanged:Connect(function(i)
        if not drag then return end
        if i.UserInputType == Enum.UserInputType.MouseMovement
        or i.UserInputType == Enum.UserInputType.Touch then
            local d = i.Position - ds
            frame.Position = UDim2.new(
                sp.X.Scale, sp.X.Offset + d.X,
                sp.Y.Scale,  sp.Y.Offset + d.Y)
        end
    end)
    UIS.InputEnded:Connect(function(i)
        if i.UserInputType == Enum.UserInputType.MouseButton1
        or i.UserInputType == Enum.UserInputType.Touch then
            drag = false
        end
    end)
end

-- สร้าง panel มาตรฐาน
local function MakePanel(name, pos, w, h, accentColor)
    local F = Instance.new("Frame", Root)
    F.Name                   = name
    F.Size                   = UDim2.new(0, w, 0, h)
    F.Position               = pos
    F.BackgroundColor3       = Color3.fromRGB(10, 10, 13)
    F.BackgroundTransparency = 0.1
    F.BorderSizePixel        = 0
    F.Active                 = true
    F.ClipsDescendants       = true
    local co = Instance.new("UICorner", F); co.CornerRadius = UDim.new(0,10)

    -- accent top bar
    local acc = Instance.new("Frame", F)
    acc.Size             = UDim2.new(1,0,0,3)
    acc.BackgroundColor3 = accentColor or Color3.fromRGB(100,80,220)
    acc.BorderSizePixel  = 0

    -- header
    local hdr = Instance.new("Frame", F)
    hdr.Name             = "Hdr"
    hdr.Size             = UDim2.new(1,0,0,30)
    hdr.Position         = UDim2.new(0,0,0,3)
    hdr.BackgroundTransparency = 1

    local ttl = Instance.new("TextLabel", hdr)
    ttl.Size             = UDim2.new(1,-36,1,0)
    ttl.Position         = UDim2.new(0,8,0,0)
    ttl.BackgroundTransparency = 1
    ttl.Font             = Enum.Font.GothamBold
    ttl.TextSize         = isMobile and 12 or 11
    ttl.TextColor3       = Color3.fromRGB(220,220,220)
    ttl.TextXAlignment   = Enum.TextXAlignment.Left
    ttl.Text             = name

    -- collapse btn
    local btn = Instance.new("TextButton", hdr)
    btn.Size             = UDim2.new(0,26,0,26)
    btn.Position         = UDim2.new(1,-30,0.5,-13)
    btn.BackgroundColor3 = Color3.fromRGB(30,30,38)
    btn.TextColor3       = Color3.fromRGB(180,180,180)
    btn.Font             = Enum.Font.GothamBold
    btn.TextSize         = 13
    btn.Text             = "−"
    btn.BorderSizePixel  = 0
    local bc = Instance.new("UICorner",btn); bc.CornerRadius=UDim.new(0,5)

    -- body
    local body = Instance.new("Frame", F)
    body.Name            = "Body"
    body.Size            = UDim2.new(1,-16,1,-36)
    body.Position        = UDim2.new(0,8,0,34)
    body.BackgroundTransparency = 1

    local lst = Instance.new("UIListLayout", body)
    lst.Padding          = UDim.new(0,5)
    lst.SortOrder        = Enum.SortOrder.LayoutOrder

    -- collapse
    local collapsed = false
    btn.MouseButton1Click:Connect(function()
        collapsed = not collapsed
        F.ClipsDescendants = true
        if collapsed then
            F.Size = UDim2.new(0,w,0,33)
            btn.Text = "+"
        else
            F.Size = UDim2.new(0,w,0,h)
            btn.Text = "−"
        end
    end)

    MakeDraggable(F, hdr)
    return F, body, ttl
end

