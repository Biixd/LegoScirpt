local ghostPrevPos
local ghostPrevTime
local ghostSpeedHistory = {}
local MAX_HISTORY = 10

local function getSpeedCategory(speed)
    if speed < 1 then
        return "Status: very slow", Color3.fromRGB(120, 200, 255)
    elseif speed < 3.5 then
        return "Status: normal", Color3.fromRGB(100, 255, 130)
    elseif speed < 6 then
        return "Status: fast", Color3.fromRGB(255, 210, 80)
    elseif speed < 9 then
        return "Status: very fast", Color3.fromRGB(255, 135, 70)
    end
    return "Status: hunting speed", Color3.fromRGB(255, 70, 70)
end

local function updateGhostSpeed(ghost)
    if not Config.ShowSpeedTracker then return end

    local ghostPos = getPosition(ghost)
    local now = os.clock()
    if ghost and ghostPos and ghostPrevPos and ghostPrevTime then
        local dt = now - ghostPrevTime
        if dt > 0.05 then
            local speed = (ghostPos - ghostPrevPos).Magnitude / dt
            if speed < 150 then
                table.insert(ghostSpeedHistory, speed)
                if #ghostSpeedHistory > MAX_HISTORY then
                    table.remove(ghostSpeedHistory, 1)
                end

                local total = 0
                local maxSpeed = 0
                for _, value in ipairs(ghostSpeedHistory) do
                    total = total + value
                    if value > maxSpeed then
                        maxSpeed = value
                    end
                end

                local average = total / #ghostSpeedHistory
                local status, color = getSpeedCategory(speed)
                SpeedValueLabel.Text = string.format("Speed: %.2f u/s", speed)
                SpeedValueLabel.TextColor3 = color
                SpeedStatusLabel.Text = status
                SpeedStatusLabel.TextColor3 = color
                SpeedAvgLabel.Text = string.format("Avg: %.2f | Max: %.2f", average, maxSpeed)
            end
        end
    elseif not ghost then
        ghostSpeedHistory = {}
        SpeedValueLabel.Text = "Speed: --"
        SpeedValueLabel.TextColor3 = Colors.Muted
        SpeedStatusLabel.Text = "Status: waiting for ghost"
        SpeedStatusLabel.TextColor3 = Colors.Muted
        SpeedAvgLabel.Text = "Avg: -- | Max: --"
    end

    ghostPrevPos = ghostPos
    ghostPrevTime = ghostPos and now or nil
end

local function updatePlayers(localPosition)
    if not Config.PlayerESP then
        destroyESPWithPrefix("player:")
        return
    end

    local alive = {}
    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer and player.Character then
            local allowed = Config.SelectedPlayer == "All" or Config.SelectedPlayer == player.Name
            local id = "player:" .. player.UserId
            alive[id] = true
            if allowed then
                local distance = getDistanceText(localPosition, player.Character)
                setESP(id, player.Character, "[" .. distance .. "m] " .. player.Name, Colors.Player)
            else
                destroyESP(id)
            end
        end
    end

