            {ConfigKey = "MusicBoxESP",        Name = "MusicBox",  Path = nil,                         Icon = "🎵", Color = Color3.fromRGB(255, 200, 0)},
            {ConfigKey = "TarotCardsESP",      Name = "Tarot",     Path = "Map.Items.Tarot Cards",     Icon = "🃏", Color = Color3.fromRGB(255, 100, 150)},
            {ConfigKey = "SpiritBoardESP",     Name = "SpiritBoard",Path = "Spirit Board",             Icon = "🟫", Color = Color3.fromRGB(200, 200, 200)}
