local function isRealCursedObject(o)
    if not o then return false end
    local a = getAdornee(o)
    if not a then return false end
    -- skip invisible spawn markers (CursedSpawns parts are Transparency=1)
    if o:IsA("BasePart") and o.Transparency >= 1 then return false end
    if a:IsA("BasePart") and a.Transparency >= 1 then
        -- allow Tools (Handle may be visible even if adornee picked is hidden part); require at least one visible part
        local vis = false
        for _, p in ipairs(o:GetDescendants()) do
            if p:IsA("BasePart") and p.Transparency < 1 then vis = true break end
        end
        if o:IsA("Tool") and vis then return true end
        return false
    end
    -- must NOT be inside CursedSpawns (markers folder)
    local _m = workspace:FindFirstChild("Map")
    local _cs = _m and _m:FindFirstChild("CursedSpawns")
    if _cs and o:IsDescendantOf(_cs) then return false end
    return true
end

local function findCursedStrict(names)
    -- 1) Real loose items at Workspace top-level (e.g. Workspace.BooBooDoll) - EXCLUDES player characters and Map markers
    for _, n in ipairs(names) do
        local d = workspace:FindFirstChild(n)
        if d and isRealCursedObject(d) then return d end
    end
    -- 2) Map.Items exact only (unpicked tools)
    local m = workspace:FindFirstChild("Map")
    local items = m and m:FindFirstChild("Items")
    if items then
        for _, n in ipairs(names) do
            local d = items:FindFirstChild(n)
            if d and isRealCursedObject(d) then return d end
        end
    end
    return nil
end

local function updateCursed(localPosition)
    for _, def in ipairs(CurseDefs) do
        if Options[def.Flag] and Options[def.Flag].Value then
            local object = findCursedStrict(def.Names)
            if object and object.Parent then
                setESP(def.Id, object, "[" .. getDistanceText(localPosition, object) .. "m] " .. def.Label, def.Color)
            else
                destroyESP(def.Id)
            end
        else
            destroyESP(def.Id)
        end
    end
end

-- ===== Cursed round notifier (v1.2): says which cursed this round, even if picked =====
local CursedAllNames = {
  {"SummoningCircle", "Summoning Circle"}, {"MusicBox", "Music Box"},
  {"SpiritBoard", "Spirit Board"}, {"TarotCards", "Tarot Cards"},
  {"BooBooDoll", "BooBoo Doll"}, {"OuijaBoard", "Ouija Board"},
  {"HauntedMirror", "Haunted Mirror"}, {"VoodooDoll", "Voodoo Doll"},
}
ENV.GhostHubRoundCursed = ENV.GhostHubRoundCursed or nil
local lastCursedRoundId = nil
local function scanCursedAnywhere()
  local m = workspace:FindFirstChild("Map")
  -- 1) loose in Workspace top-level (e.g. Workspace.BooBooDoll)
  for _, grp in ipairs(CursedAllNames) do
    for _, n in ipairs(grp) do
      local d = workspace:FindFirstChild(n)
      if d and isRealCursedObject(d) then return grp[2], "map", nil end
    end
  end
  -- 2) Map.Items
  local items = m and m:FindFirstChild("Items")
  if items then
    for _, grp in ipairs(CursedAllNames) do
      for _, n in ipairs(grp) do
        local d = items:FindFirstChild(n)
        if d and isRealCursedObject(d) then return grp[2], "map", nil end
      end
    end
  end
  -- 3) held by players (picked already) -> still tells which one
  for _, p in ipairs(Players:GetPlayers()) do
    local function hasIn(container)
      if not container then return nil end
      for _, grp in ipairs(CursedAllNames) do
        for _, n in ipairs(grp) do
          if container:FindFirstChild(n) then return grp[2] end
        end
      end
      return nil
    end
    local ch = p.Character
    local hit = hasIn(ch)
    if hit then return hit, "held", p.Name end
    local bp = p:FindFirstChild("Backpack")
    hit = hasIn(bp)
    if hit then return hit, "held", p.Name end
    -- character model lives under Workspace.<name> when in-game
    local wm = workspace:FindFirstChild(p.Name)
    hit = hasIn(wm)
    if hit then return hit, "held", p.Name end
  end
  return nil, nil, nil
end
local function announceCursed(force)
  local name, where, holder = scanCursedAnywhere()
  if name then
    ENV.GhostHubRoundCursed = name
    if where == "held" then
      notify("Cursed รอบนี้: " .. name, "มีคนเก็บไปแล้ว (" .. tostring(holder) .. ")", 6)
    else
      notify("Cursed รอบนี้: " .. name, "ยังวางอยู่ในแมพ ไป ESP ได้เลย", 6)
    end
  else
    if ENV.GhostHubRoundCursed then
      notify("Cursed รอบนี้: " .. ENV.GhostHubRoundCursed, "โดนเก็บไปแล้ว (ไม่อยู่ในแมพ)", 6)
    elseif force then
      notify("Cursed", "ยังไม่เจอ (อยู่ lobby หรือรอรอบใหม่)", 4)
    end
  end
end
