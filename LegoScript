local function BuildPanel(opts)
    --[[
        opts = {
            name, pos, size, title, color(optional)
        }
    --]]
    local F = Instance.new("Frame")
    F.Name                 = opts.name
    F.Size                 = opts.size or UDim2.new(0, 200, 0, 40)
    F.Position             = opts.pos  or UDim2.new(0, 10, 0, 10)
    F.BackgroundColor3     = opts.color or Color3.fromRGB(12, 12, 14)
    F.BackgroundTransparency = 0.15
    F.BorderSizePixel      = 0
    F.Active               = true
    F.ClipsDescendants     = true
    F.Parent               = Root
    NewCorner(F, 10)

    -- thin accent line on top
    local Accent = Instance.new("Frame", F)
    Accent.Size               = UDim2.new(1, 0, 0, 2)
    Accent.Position           = UDim2.new(0,0,0,0)
    Accent.BackgroundColor3   = opts.accent or Color3.fromRGB(120, 80, 220)
    Accent.BorderSizePixel    = 0

    -- Header bar (draggable)
    local Header = Instance.new("Frame", F)
    Header.Name               = "Header"
    Header.Size               = UDim2.new(1, 0, 0, 34)
    Header.Position           = UDim2.new(0, 0, 0, 2)
    Header.BackgroundColor3   = Color3.fromRGB(20, 20, 24)
    Header.BackgroundTransparency = 0.3
    Header.BorderSizePixel    = 0
    NewCorner(Header, 8)

    local Title = Instance.new("TextLabel", Header)
    Title.Size                = UDim2.new(1, -44, 1, 0)
    Title.Position            = UDim2.new(0, 10, 0, 0)
    Title.BackgroundTransparency = 1
    Title.Text                = opts.title or "Panel"
    Title.TextColor3          = Color3.fromRGB(230, 230, 230)
    Title.Font                = Enum.Font.GothamBold
    Title.TextSize            = isMobile and 13 or 12
    Title.TextXAlignment      = Enum.TextXAlignment.Left
    Title.TextTruncate        = Enum.TextTruncate.AtEnd

    -- Collapse / expand button
    local Btn = Instance.new("TextButton", Header)
    Btn.Name                  = "CollapseBtn"
    Btn.Size                  = UDim2.new(0, 28, 0, 28)
    Btn.Position              = UDim2.new(1, -32, 0.5, -14)
    Btn.BackgroundColor3      = Color3.fromRGB(40, 40, 50)
    Btn.TextColor3            = Color3.fromRGB(200, 200, 200)
    Btn.Font                  = Enum.Font.GothamBold
    Btn.TextSize              = 14
    Btn.Text                  = "−"
    Btn.BorderSizePixel       = 0
    NewCorner(Btn, 6)

    -- Body
    local Body = Instance.new("Frame", F)
    Body.Name                 = "Body"
    Body.Size                 = UDim2.new(1, 0, 1, -38)
    Body.Position             = UDim2.new(0, 0, 0, 38)
    Body.BackgroundTransparency = 1
    Body.BorderSizePixel      = 0
    NewPadding(Body, 8)

    local List = Instance.new("UIListLayout", Body)
    List.Padding              = UDim.new(0, 5)
    List.SortOrder            = Enum.SortOrder.LayoutOrder

    -- collapse logic
    local collapsed = false
    local fullH = opts.size and opts.size.Y.Offset or 180
    Btn.MouseButton1Click:Connect(function()
        collapsed = not collapsed
        if collapsed then
            F.Size  = UDim2.new(F.Size.X.Scale, F.Size.X.Offset, 0, 36)
            Btn.Text = "+"
        else
            F.Size  = UDim2.new(F.Size.X.Scale, F.Size.X.Offset, 0, fullH)
            Btn.Text = "−"
        end
    end)

    MakeDraggable(F, Header)
    return F, Body, List
end

