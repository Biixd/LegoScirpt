local function GetSpeedCategory(speed)
    -- ความเร็วปกติ Phasmophobia-style (studs/s)
    if speed < 1 then
        return "🐌 ช้ามาก (ผีไม่วิ่ง)", Color3.fromRGB(100, 200, 255)
    elseif speed < 3.5 then
        return "🚶 ปกติ (Normal)", Color3.fromRGB(100, 255, 100)
    elseif speed < 6 then
        return "🏃 เร็ว (Fast)", Color3.fromRGB(255, 200, 0)
    elseif speed < 9 then
        return "⚡ เร็วมาก (Very Fast)", Color3.fromRGB(255, 100, 0)
    else
        return "💀 วิ่งหาตัว! (HUNTING)", Color3.fromRGB(255, 0, 0)
    end
end

