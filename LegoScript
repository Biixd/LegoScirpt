local function UpdateEvidence(name, isFound)
    if EvidenceState[name] and EvidenceState[name].Found ~= isFound then
        EvidenceState[name].Found = isFound
        if isFound then
            EvidenceState[name].Label.Text = "✅ " .. name
            EvidenceState[name].Label.TextColor3 = Color3.fromRGB(0, 255, 100)
        else
            EvidenceState[name].Label.Text = "❌ " .. name
            EvidenceState[name].Label.TextColor3 = Color3.fromRGB(255, 100, 100)
        end
    end
end

