local accum = {
    fast = 0,
    normal = 0,
    slow = 0,
    cleanup = 0
}

connect(RunService.Heartbeat, function(dt)
    if not Running then return end

    accum.fast = accum.fast + dt
    accum.normal = accum.normal + dt
    accum.slow = accum.slow + dt
    accum.cleanup = accum.cleanup + dt

    if accum.fast >= 0.18 then
        accum.fast = 0
        local root = getLocalRoot()
        local localPosition = root and root.Position or nil
        updateGhost(localPosition)
        updateSLS(localPosition)
        updatePlayers(localPosition)
    end

    if accum.normal >= 0.75 then
        accum.normal = 0
        local root = getLocalRoot()
        local localPosition = root and root.Position or nil
        updateGenerators(localPosition)
        updateEMF(localPosition)
        updateOrb(localPosition)
        updateCursed(localPosition)
    end

    if accum.slow >= 1.5 then
        accum.slow = 0
        local root = getLocalRoot()
        local localPosition = root and root.Position or nil
        updateFullbright()
        updateColdestRoom(localPosition)
        updateUV()
        updateSalt()
        updateWriting()
    end

    if accum.cleanup >= 4 then
        accum.cleanup = 0
        cleanupInvalidESP()
    end
end)

