         local items = workspace.Map:FindFirstChild("Items")
         if items then
             return items:FindFirstChild("Tarot Cards")
                 or items:FindFirstChild("TarotCards")
         end
         return nil
     end},
    {cfgKey="SpiritESP", tag="Spirit", icon="🟫",
     color=Color3.fromRGB(200,200,200),
     search=function()
         return workspace:FindFirstChild("Spirit Board",true)
             or workspace.Map:FindFirstChild("SpiritBoard",true)
     end},
}

-- track object เพื่อ cleanup
local CurseTracked = {}

-- =====================================================
--  MAIN LOOP
-- =====================================================
task.spawn(function()
    local TICK = 0
    while true do
        task.wait(0.25)
        TICK = TICK + 1

        local char  = LocalPlayer.Character
        local root  = char and char:FindFirstChild("HumanoidRootPart")
        local myPos = root and root.Position or Vector3.zero

        -- ── Fullbright ──────────────────────────────
        if CFG.Fullbright then
            Lighting.Brightness    = 2
            Lighting.ClockTime     = 14
            Lighting.FogEnd        = 1e5
            Lighting.GlobalShadows = false
            Lighting.Ambient       = Color3.fromRGB(178,178,178)
        end

        -- ── Player ESP ──────────────────────────────
        for _, p in ipairs(Players:GetPlayers()) do
            if p == LocalPlayer then continue end
            local pc = p.Character
            if not pc then continue end
            local want = CFG.PlayerESP and (CFG.SelectedPlayer=="All" or CFG.SelectedPlayer==p.Name)
            if want then
                AddESP(pc, "Player", Color3.fromRGB(70,220,70))
                -- ชื่อย่อบนมือถือ
                local nm = isMobile and p.Name:sub(1,9) or p.Name
                local d  = GetDist(myPos, pc)
                UpdateESP(pc, "Player", ("👤 %s  %sm"):format(nm, d))
            else
                RemoveESP(pc, "Player")
            end
        end

        -- ── Ghost: ค้นหาแบบ safe ──────────────────────
        -- ค้นหลาย pattern เพราะแต่ละ map อาจใช้ชื่อต่างกัน
        local ghost = nil
        pcall(function()
            ghost = workspace:FindFirstChild("Ghost")
                 or workspace:FindFirstChild("Ghost", true)  -- recursive
        end)
        -- ถ้ายังหาไม่เจอ ลองหาแบบ loop (ครอบคลุมกรณีผีซ่อนใน folder)
        if not ghost or not ghost.Parent then
            pcall(function()
                for _, obj in ipairs(workspace:GetChildren()) do
                    if obj.Name == "Ghost" then ghost = obj; break end
                    -- บางเกมผีอยู่ใน folder ชื่ออื่น
                    if obj:IsA("Folder") or obj:IsA("Model") then
                        local g = obj:FindFirstChild("Ghost")
                        if g then ghost = g; break end
                    end
                end
            end)
        end

        -- ── Ghost Speed ─────────────────────────────
        if ghost and ghost.Parent then
            local gpos = GetPos(ghost)
            local now  = tick()
            if gpos and spdPrev and spdPrevT then
                local dt = now - spdPrevT
                if dt >= 0.08 then
                    local spd = (gpos - spdPrev).Magnitude / dt
                    -- กรอง noise (ผีเทเลพอต)
                    if spd < 50 then
                        table.insert(spdHist, spd)
                        if #spdHist > SPD_HIST then table.remove(spdHist,1) end
                        local tot, mx = 0, 0
                        for _, s in ipairs(spdHist) do
                            tot=tot+s
                            if s>mx then mx=s end
                        end
                        local avg = tot / #spdHist
                        local cat, col = SpdCat(spd)
                        SpdCur.Text      = ("%.1f u/s"):format(spd)
                        SpdCur.TextColor3 = col
                        SpdAvg.Text      = ("%.1f u/s"):format(avg)
                        SpdMax.Text      = ("%.1f u/s"):format(mx)
                        SpdBadge.Text        = cat
                        SpdBadge.TextColor3  = col
                    end
                    spdPrev  = gpos
                    spdPrevT = now
                end
            else
                spdPrev  = GetPos(ghost)
                spdPrevT = tick()
            end
        else
            -- reset
            spdPrev=nil; spdPrevT=nil; spdHist={}
            SpdCur.Text="--"; SpdAvg.Text="--"; SpdMax.Text="--"
            SpdBadge.Text="รอผีปรากฏ..."; SpdBadge.TextColor3=Color3.fromRGB(120,120,135)
            ClearAlert("ghost")
        end

        -- Ghost ESP
        if CFG.GhostESP and ghost and ghost.Parent then
            local ok = AddESP(ghost, "Ghost", Color3.fromRGB(255,55,55))
            if ok then
                UpdateESP(ghost,"Ghost",("👻 Ghost  %sm"):format(GetDist(myPos,ghost)))
            end
            Alert("ghost","👻 Ghost!","ผีปรากฏตัวแล้ว ระวัง!")
        elseif (not CFG.GhostESP or not ghost) and ghost then
            RemoveESP(ghost, "Ghost")
        end
        if not ghost then ClearAlert("ghost") end

        -- ── SLS Ghost ───────────────────────────────
        local sls = nil
        pcall(function() sls = workspace:FindFirstChild("SLS_GHOST") end)
        SetEvid("SLS Ghost", sls ~= nil)

        if CFG.SLSESP and sls and sls.Parent then
            AddESP(sls,"SLS",Color3.fromRGB(255,155,0))
            UpdateESP(sls,"SLS",("📷 SLS  %sm"):format(GetDist(myPos,sls)))
            Alert("sls","📷 SLS Ghost!","ตรวจพบ SLS Ghost")
        else
            if sls then RemoveESP(sls,"SLS") end
            if not sls then ClearAlert("sls") end
        end

        -- ── EMF Reader ──────────────────────────────
        local isEMF5 = false
        pcall(function()
            local emf = workspace.Map.Items:FindFirstChild("EMF Reader")
            if not emf then return end
            local lv = 0
            for i=5,1,-1 do
                local lf = emf:FindFirstChild(tostring(i))
                if lf then
                    for _, d in ipairs(lf:GetDescendants()) do
                        if d:IsA("BasePart") and d.Material==Enum.Material.Neon then
                            lv=i; break
                        end
                    end
                    if lv>0 then break end
                end
            end
            if lv==5 then isEMF5=true end
            if CFG.EMFESP then
                if lv>0 then
                    local c = lv==5 and Color3.fromRGB(255,0,0)
                           or lv>=3 and Color3.fromRGB(255,220,0)
                           or Color3.fromRGB(0,220,80)
                    AddESP(emf,"EMF",c)
                    UpdateESP(emf,"EMF",("📡 EMF Lv%d  %sm"):format(lv, GetDist(myPos,emf)))
                else
                    RemoveESP(emf,"EMF")
                end
            else
                RemoveESP(emf,"EMF")
            end
        end)
        SetEvid("EMF Level 5", isEMF5)
        if isEMF5 then Alert("emf5","📡 EMF Level 5","ตรวจพบ EMF Level 5")
        else ClearAlert("emf5") end

        -- ── Generator ───────────────────────────────
        pcall(function()
            local gens = workspace.Map.Generators:GetChildren()
            for _, gen in ipairs(gens) do
                if CFG.GeneratorESP and gen.Parent then
                    AddESP(gen,"Gen",Color3.fromRGB(255,230,0))
                    UpdateESP(gen,"Gen",("⚡ Gen  %sm"):format(GetDist(myPos,gen)))
                else
                    RemoveESP(gen,"Gen")
                end
            end
        end)

        -- ── Coldest Room ────────────────────────────
        local isFreeze = false
        pcall(function()
            local coldT, coldZ = math.huge, nil
            for _, z in ipairs(workspace.Map.Zones:GetChildren()) do
                for _, c in ipairs(z:GetChildren()) do
                    if c:IsA("NumberValue") and c.Name:find("Temp") then
                        if c.Value < 0 then isFreeze=true end
                        if c.Value < coldT then coldT=c.Value; coldZ=z end
                    end
                end
            end
            if CFG.ColdRoomESP then
                if coldZ then
                    local col = coldT<0 and Color3.fromRGB(0,230,230) or Color3.fromRGB(0,160,255)
                    AddESP(coldZ,"Cold",col)
                    local nm = coldZ.Name:sub(1,8)
                    UpdateESP(coldZ,"Cold",("❄ %s %.0f°  %sm"):format(nm,coldT,GetDist(myPos,coldZ)))
                end
            else
                for _, z in ipairs(workspace.Map.Zones:GetChildren()) do
                    RemoveESP(z,"Cold")
                end
            end
        end)
        SetEvid("Freezing Temp", isFreeze)
        if isFreeze then Alert("frz","🥶 Freezing Temp","ตรวจพบห้องอุณหภูมิต่ำ")
        else ClearAlert("frz") end

        -- ── Ghost Orb ───────────────────────────────
        local orbFound = false
        pcall(function()
            local orb = workspace.Map.Orbs:FindFirstChild("OrbPart")
            if orb and orb.Parent then
                orbFound=true
                if CFG.OrbESP then
                    AddESP(orb,"Orb",Color3.fromRGB(180,0,255))
                    UpdateESP(orb,"Orb",("🔮 Orb  %sm"):format(GetDist(myPos,orb)))
                else
                    RemoveESP(orb,"Orb")
                end
            end
        end)
        SetEvid("Ghost Orb", orbFound)
        if orbFound then Alert("orb","🔮 Ghost Orb","ตรวจพบ Ghost Orb")
        else ClearAlert("orb") end

        -- ── Ultraviolet ─────────────────────────────
        local uvFound = false
        pcall(function()
            local prints = workspace.Map:FindFirstChild("Prints")
            if not prints then return end
            -- รอยเท้า
            if prints:FindFirstChild("UV_BootL") or prints:FindFirstChild("UV_BootR") then
                uvFound=true; return
            end
            -- รอยนิ้วมือ
            local hf = prints:FindFirstChild("UV_Hand")
            if hf then
                uvFound = not hf:IsA("Folder") or (#hf:GetChildren()>0)
                if uvFound then return end
            end
            -- scan descendant
            for _, d in ipairs(prints:GetDescendants()) do
                if d.Name:sub(1,3)=="UV_" then uvFound=true; break end
            end
        end)
        SetEvid("Ultraviolet", uvFound)
        if uvFound then Alert("uv","💡 Ultraviolet","ตรวจพบรอย UV")
        else ClearAlert("uv") end

        -- ── Salt Stepped ────────────────────────────
        local saltFound = false
        pcall(function()
            saltFound = workspace:FindFirstChild("SaltStepped") ~= nil
        end)
        SetEvid("Salt Stepped", saltFound)
        if saltFound then Alert("salt","🧂 Salt!","ผีเหยียบเกลือแล้ว")
        else ClearAlert("salt") end

        -- ── Ghost Writing ───────────────────────────
        local wrtFound = false
        pcall(function()
            local book = workspace.Map.Items["Ghost Writing Book"]
            if not book then return end
            local h = book:FindFirstChild("Handle")
            if not h then return end
            for _, c in ipairs(h:GetChildren()) do
                if c.Name:match("^Writing%d+$") then wrtFound=true; break end
            end
        end)
        SetEvid("Ghost Writing", wrtFound)
        if wrtFound then Alert("wrt","📝 Ghost Writing","ตรวจพบ Ghost Writing")
        else ClearAlert("wrt") end

        -- ── Cursed Items ────────────────────────────
        for _, def in ipairs(CURSE_DEFS) do
            local obj = nil
            pcall(function() obj = def.search() end)

            local valid = obj and obj.Parent and obj:IsDescendantOf(workspace)

            -- cleanup ถ้า object เปลี่ยน
            local prev = CurseTracked[def.tag]
            if prev and prev ~= obj then
                pcall(function() RemoveESP(prev, def.tag) end)
                CurseTracked[def.tag] = nil
            end

            if CFG[def.cfgKey] and valid then
                AddESP(obj, def.tag, def.color)
                UpdateESP(obj, def.tag,
                    ("%s %s  %sm"):format(def.icon, def.tag, GetDist(myPos,obj)))
                CurseTracked[def.tag] = obj
            else
                if valid then RemoveESP(obj, def.tag) end
                CurseTracked[def.tag] = nil
            end
        end

    end -- while
end)

-- =====================================================
--  READY
-- =====================================================
Notification.new({
    Title       = "GHOST HUB",
    Description = "โหลดสำเร็จ ✓ Mobile Edition v4",
    Duration    = 4,
})
