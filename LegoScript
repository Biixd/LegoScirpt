    { key="CircleESP", id="Circle",  icon="🔮", color=Color3.fromRGB(170,0,255),
      names={"SummoningCircle","Summoning Circle"}, containers={"Map"} },
    { key="BooESP",    id="BooBoo",  icon="🧸", color=Color3.fromRGB(255,0,255),
