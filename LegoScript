local accum = { fast = 0, normal = 0, slow = 0, cleanup = 0 }
connect(RunService.Heartbeat, function(dt)
    if not Running then return end
    accum.fast += dt accum.normal += dt accum.slow += dt accum.cleanup += dt
    if accum.fast >= 0.18 then
        accum.fast = 0
        local root = getLocalRoot() local pos = root and root.Position or nil
        updateGhost(pos) updateSLS(pos) updatePlayers(pos)
    end
    if accum.normal >= 0.75 then
        accum.normal = 0
        local root = getLocalRoot() local pos = root and root.Position or nil
        updateGenerators(pos) updateEMF(pos) updateOrb(pos) updateCursed(pos)
    end
    if accum.slow >= 1.5 then
        accum.slow = 0
        local root = getLocalRoot() local pos = root and root.Position or nil
        updateFullbright() updateColdestRoom(pos) updateUV() updateSalt() updateWriting() pcall(function() refreshGhostFinder() end)
    end
    if accum.cleanup >= 4 then accum.cleanup = 0 cleanupInvalidESP() end
end)
