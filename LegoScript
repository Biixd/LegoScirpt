local function getTemperature(zone)
    local t = zone:FindFirstChild("_____Temperature")
    if t and t:IsA("NumberValue") then return t.Value end
    for _, object in ipairs(zone:GetDescendants()) do
        if (object:IsA("NumberValue") or object:IsA("IntValue")) and string.find(string.lower(object.Name), "temperature") then return object.Value end
    end
    return nil
end
local function updateColdestRoom(localPosition)
    local zones = child(map(), "Zones")
    if not zones then destroyESP("coldest-room") updateEvidence("Freezing Temp", false) return end
    local coldestRoom local coldestTemp = math.huge local freezing = false
    for _, zone in ipairs(zones:GetChildren()) do
        if zone.Name == "Hitboxes" then continue end
        if not zone:IsA("BasePart") then continue end
        local temperature = getTemperature(zone)
        if temperature then
            if temperature < 0 then freezing = true end
            if temperature < coldestTemp then coldestTemp = temperature coldestRoom = zone end
        end
    end
    updateEvidence("Freezing Temp", freezing)
    alertOnce("freezing", freezing, "เจอหลักฐาน", "ตรวจพบ Freezing Temperature")
    if Options.ColdestRoomESP.Value and coldestRoom then
        local color = coldestTemp < 0 and Colors.Freezing or Colors.ColdRoom
        setESP("coldest-room", coldestRoom, string.format("[%sm] %s (%.1f)", getDistanceText(localPosition, coldestRoom), coldestRoom.Name, coldestTemp), color)
    else destroyESP("coldest-room") end
end

