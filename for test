-- Helper: Get Center Position of any Instance safely
local function getInstancePosition(inst)
    if not inst or not inst:IsDescendantOf(Workspace) then return nil end
    
    if inst:IsA("BasePart") then
        return inst.Position
    elseif inst:IsA("Model") then
        if inst.PrimaryPart then
            return inst.PrimaryPart.Position
        else
            local cframe, size = inst:GetBoundingBox()
            return cframe.Position
        end
    end
    return nil
end

-- Helper: Check if Ghost Writing Book has been written in
local function isBookWritten(book)
    local handle = book:FindFirstChild("Handle")
    if handle then
        for _, child in ipairs(handle:GetChildren()) do
            -- Matches "Writing8" or any other "Writing" variants (1-25)
            if child.Name:find("Writing") then
                -- Check transparency if it's a Decal or Part
                if child:IsA("BasePart") or child:IsA("Decal") or child:IsA("Texture") then
                    if child.Transparency < 1 then
                        return true, child.Name
                    end
                else
                    return true, child.Name
                end
            end
        end
    end
    return false, nil
end

