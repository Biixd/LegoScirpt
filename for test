local function getAdornee(object)
    if not object then return nil end
    if object:IsA("BasePart") then
        return object
    end
    if object:IsA("Model") then
        return object.PrimaryPart or object:FindFirstChildWhichIsA("BasePart", true)
    end
    return object:FindFirstChildWhichIsA("BasePart", true)
end

local function getPosition(object)
    local part = getAdornee(object)
    if part then return part.Position end
    if object and object:IsA("Model") then
        local ok, pivot = pcall(function() return object:GetPivot() end)
        if ok and pivot then return pivot.Position end
    end
    return nil
end

local function getDistanceText(fromPosition, object)
    local position = getPosition(object)
    if not fromPosition or not position then return "?" end
    return tostring(math.floor((fromPosition - position).Magnitude))
end

