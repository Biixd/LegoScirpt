local Alerts = {}
local function alertOnce(key, active, title, description)
    if active and not Alerts[key] then
        Alerts[key] = true
        if Options.Notifications.Value then
            notify(title, description, 5)
        end
    elseif not active then
        Alerts[key] = false
    end
end

local function findItemSafe(container, names)
    if not container then return nil end
    for _, name in ipairs(names) do
        local direct = container:FindFirstChild(name)
        if direct then return direct end
    end
    for _, name in ipairs(names) do
        local target = string.lower(name):gsub("%s+", "")
        for _, object in ipairs(container:GetDescendants()) do
            if string.lower(object.Name):gsub("%s+", "") == target then
                return object
            end
        end
    end
    return nil
end

local function findItemInContainers(names, containers)
    for _, container in ipairs(containers) do
        local found = findItemSafe(container, names)
        if found and found:IsDescendantOf(workspace) then
            return found
        end
    end
    return nil
end

