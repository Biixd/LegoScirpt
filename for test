-- Helper: Scan EMF Readers and find the highest level currently showing Neon
local function getEMFLevel()
    local maxLevel = 1
    local readers = {}
    
    local mapFolder = Workspace:FindFirstChild("Map")
    local itemsFolder = mapFolder and mapFolder:FindFirstChild("Items")
    
    -- Scan Ground Items
    if itemsFolder then
        for _, child in ipairs(itemsFolder:GetChildren()) do
            if child.Name == "EMF Reader" then
                table.insert(readers, child)
            end
        end
    end
    
    -- Scan Players
    for _, ply in ipairs(Players:GetPlayers()) do
        local char = ply.Character
        if char then
            for _, child in ipairs(char:GetChildren()) do
                if child.Name == "EMF Reader" or (child:IsA("Tool") and child.Name == "EMF Reader") then
                    table.insert(readers, child)
                end
            end
        end
    end
    
    -- Check neon lights on EMF readers
    for _, reader in ipairs(readers) do
        for level = 5, 1, -1 do
            local indicator = reader:FindFirstChild(tostring(level))
            if indicator and indicator:IsA("BasePart") then
                if indicator.Material == Enum.Material.Neon then
                    if level > maxLevel then
                        maxLevel = level
                    end
                    break
                end
            end
        end
    end
    
    return maxLevel
end

-- Helper: Scan room zones and identify the room with the lowest temperature
local function getLowestTempRoom()
    local lowestRoom = nil
    local lowestTemp = 999.0
    
    local mapFolder = Workspace:FindFirstChild("Map")
    local zonesFolder = mapFolder and mapFolder:FindFirstChild("Zones")
    if zonesFolder then
        for _, room in ipairs(zonesFolder:GetChildren()) do
            -- Look for Temperature value inside the room zone
            local tempVal = nil
            for _, child in ipairs(room:GetChildren()) do
                if child.Name:find("Temperature") and child:IsA("ValueBase") then
                    tempVal = child
                    break
                end
            end
            
            if tempVal and tempVal.Value then
                local temp = tonumber(tempVal.Value)
                if temp and temp < lowestTemp then
                    lowestTemp = temp
                    lowestRoom = room
                end
            end
        end
    end
    return lowestRoom, lowestTemp
end

