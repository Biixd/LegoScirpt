-- Blink Tracker --
local ghostWasVisible = false
local blinkStartTime = 0
local blinkHistory = {}
local MAX_BLINK_HISTORY = 5

local function isGhostVisible(ghost)
    local parts = ghost:GetDescendants()
    for _, obj in ipairs(parts) do
        if obj:IsA("BasePart") and obj.Transparency < 0.5 then
            return true
        end
    end
    return false
end

local function updateBlink(ghost)
    if not Options.ShowSpeedTracker.Value then
        BlinkDurationLabel.Text = "Blink: --"
        BlinkLastLabel.Text = "Last Blink: --"
        return
    end

    if not ghost then
        ghostWasVisible = false
        blinkStartTime = 0
        blinkHistory = {}
        BlinkDurationLabel.Text = "Blink: --"
        BlinkLastLabel.Text = "Last Blink: --"
        return
    end

    local visible = isGhostVisible(ghost)

    if visible and not ghostWasVisible then
        local now = os.clock()
        if blinkStartTime > 0 then
            local blinkDuration = now - blinkStartTime
            if blinkDuration > 0.05 and blinkDuration < 60 then
                table.insert(blinkHistory, blinkDuration)
                if #blinkHistory > MAX_BLINK_HISTORY then
                    table.remove(blinkHistory, 1)
                end

                local sum = 0
                for _, v in ipairs(blinkHistory) do
                    sum = sum + v
                end
                local avg = sum / #blinkHistory

                BlinkDurationLabel.Text = string.format("Blink: %.2fs", avg)
                BlinkLastLabel.Text = string.format("Last Blink: %.2fs", blinkDuration)
            end
        end
        blinkStartTime = 0
    elseif not visible and ghostWasVisible then
        blinkStartTime = os.clock()
    end

    ghostWasVisible = visible
end

local function getSpeedCategory(speed)
    if speed < 1 then return "Status: very slow", Color3.fromRGB(120, 200, 255)
    elseif speed < 3.5 then return "Status: normal", Color3.fromRGB(100, 255, 130)
    elseif speed < 6 then return "Status: fast", Color3.fromRGB(255, 210, 80)
    elseif speed < 9 then return "Status: very fast", Color3.fromRGB(255, 135, 70)
    else return "Status: hunting speed", Color3.fromRGB(255, 70, 70) end
end

local function updateGhostSpeed(ghost)
    if not Options.ShowSpeedTracker.Value then return end
    local ghostPos = getPosition(ghost)
    local now = os.clock()
    if ghost and ghostPos and ghostPrevPos and ghostPrevTime then
        local dt = now - ghostPrevTime
        if dt > 0.05 then
            local speed = (ghostPos - ghostPrevPos).Magnitude / dt
            if speed < 150 then
                table.insert(ghostSpeedHistory, speed)
                if #ghostSpeedHistory > MAX_HISTORY then table.remove(ghostSpeedHistory, 1) end
                local total, maxSpeed = 0, 0
                for _, v in ipairs(ghostSpeedHistory) do
                    total = total + v
                    if v > maxSpeed then maxSpeed = v end
                end
                local avg = total / #ghostSpeedHistory
                local status, color = getSpeedCategory(speed)
                SpeedValueLabel.Text = string.format("Speed: %.2f u/s", speed)
                SpeedValueLabel.TextColor3 = color
                SpeedStatusLabel.Text = status
                SpeedStatusLabel.TextColor3 = color
                SpeedAvgLabel.Text = string.format("Avg: %.2f | Max: %.2f", avg, maxSpeed)
            end
        end
    elseif not ghost then
        ghostSpeedHistory = {}
        SpeedValueLabel.Text = "Speed: --"
        SpeedValueLabel.TextColor3 = Colors.Muted
        SpeedStatusLabel.Text = "Status: waiting for ghost"
        SpeedStatusLabel.TextColor3 = Colors.Muted
        SpeedAvgLabel.Text = "Avg: -- | Max: --"
    end
    ghostPrevPos = ghostPos
    ghostPrevTime = ghostPos and now or nil
end

local function updatePlayers(localPosition)
