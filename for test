-- [[ ESP ENGINE ]]

local function updateESP()
    local char = LocalPlayer.Character
    local root = char and char:FindFirstChild("HumanoidRootPart")
    if not root then return end
    local playerPos = root.Position

    local currentTargets = {}

    -- Sub-helper to add ESP target
    local function addTarget(instance, name, color, isRoom)
        if not instance then return end
        local pos = getInstancePosition(instance)
        if not pos then return end
        
        local dist = (playerPos - pos).Magnitude
        currentTargets[instance] = {
            Name = name,
            Color = color,
            Distance = dist,
            IsRoom = isRoom
        }
    end

    -- 1. Ghost Room ESP
    if toggles.GhostRoom then
        local lowestRoom, lowestTemp = getLowestTempRoom()
        if lowestRoom then
            local tempText = string.format("👻 Ghost Room: %s (%.1f°C)", lowestRoom.Name, lowestTemp)
            addTarget(lowestRoom, tempText, Color3.fromRGB(0, 195, 255), true)
        end
    end

    -- 2. Ghost ESP
    if toggles.Ghost then
        for _, obj in ipairs(Workspace:GetChildren()) do
            if obj.Name == "Ghost" or obj.Name == "ghost" then
                addTarget(obj, "👹 GHOST", Color3.fromRGB(255, 0, 50))
            end
        end
    end

    -- 3. SLS Ghost ESP
    if toggles.SLSGhost then
        local sls = Workspace:FindFirstChild("SLS_GHOST")
        if sls then
            addTarget(sls, "👾 SLS GHOST", Color3.fromRGB(0, 255, 255))
        end
    end

    -- 4. Ghost Orb ESP
    if toggles.GhostOrb then
        local mapFolder = Workspace:FindFirstChild("Map")
        local orbsFolder = mapFolder and mapFolder:FindFirstChild("Orbs")
        if orbsFolder then
            for _, obj in ipairs(orbsFolder:GetChildren()) do
                if obj.Name == "OrbPart" or obj:IsA("BasePart") then
                    addTarget(obj, "✨ GHOST ORB", Color3.fromRGB(230, 230, 255))
                end
            end
        end
    end

    -- 5. Ghost Writing Book ESP
    if toggles.GhostWritingBook then
        local books = findGhostWritingBooks()
        for _, book in ipairs(books) do
            local written, writingType = isBookWritten(book)
            local name = written and ("📖 GHOST WRITING (" .. writingType .. ")") or "📘 GHOST WRITING BOOK"
            local color = written and Color3.fromRGB(0, 255, 100) or Color3.fromRGB(230, 230, 0)
            local targetPart = book:FindFirstChild("Handle") or book
            addTarget(targetPart, name, color)
        end
    end

    -- 6. Generator ESP
    if toggles.Generator then
        local mapFolder = Workspace:FindFirstChild("Map")
        local gensFolder = mapFolder and mapFolder:FindFirstChild("Generators")
        if gensFolder then
            for _, obj in ipairs(gensFolder:GetChildren()) do
                local meshPart = obj:FindFirstChild("GeneratorMesh") or obj
                addTarget(meshPart, "⚡ GENERATOR", Color3.fromRGB(255, 150, 0))
            end
        end
    end

    -- 7. BooBoo Doll ESP
    if toggles.BooBooDoll then
        local doll = Workspace:FindFirstChild("BooBooDoll")
        if doll then
            addTarget(doll, "🧸 BOOBOO DOLL", Color3.fromRGB(255, 0, 255))
        end
    end

    -- 8. Summoning Circle ESP
    if toggles.SummoningCircle then
        local circle = Workspace:FindFirstChild("SummoningCircle")
        if circle then
            addTarget(circle, "⭕ SUMMONING CIRCLE", Color3.fromRGB(180, 0, 0))
        end
    end

    -- 9. Tarot Cards ESP
    if toggles.TarotCards then
        local cards = findTarotCards()
        for _, card in ipairs(cards) do
            local handle = card:FindFirstChild("Handle") or card
            addTarget(handle, "🃏 TAROT CARDS", Color3.fromRGB(255, 100, 0))
        end
    end

    -- 10. Music Box ESP
    if toggles.MusicBox then
        local boxes = findMusicBoxes()
        for _, box in ipairs(boxes) do
            local handle = box:FindFirstChild("Handle") or box
            addTarget(handle, "🎵 MUSIC BOX", Color3.fromRGB(255, 100, 200))
        end
    end

    -- 11. UV Prints ESP
    if toggles.UVPrints then
        local mapFolder = Workspace:FindFirstChild("Map")
        local printsFolder = mapFolder and mapFolder:FindFirstChild("Prints")
        if printsFolder then
            for _, obj in ipairs(printsFolder:GetChildren()) do
                if obj.Name == "UV_Hand" then
                    addTarget(obj, "✋ UV HANDPRINT", Color3.fromRGB(150, 0, 255))
                elseif obj.Name == "UV_FootL" or obj.Name == "UV_FootR" then
                    addTarget(obj, "👣 UV FOOTPRINT", Color3.fromRGB(150, 0, 255))
                end
            end
        end
    end

    -- Clean up inactive ESP items
    for inst, espData in pairs(activeEsps) do
        if not toggles.MasterESP or not currentTargets[inst] then
            if espData.Highlight then espData.Highlight:Destroy() end
            if espData.Billboard then espData.Billboard:Destroy() end
            activeEsps[inst] = nil
        end
    end

    -- Create or Update ESP visualizations
    if toggles.MasterESP then
        for inst, data in pairs(currentTargets) do
            local esp = activeEsps[inst]
            if not esp then
                -- Create Highlight
                local hl = Instance.new("Highlight")
                if data.IsRoom then
                    -- Outline only for rooms so it doesn't block player visibility
                    hl.FillColor = data.Color
                    hl.OutlineColor = data.Color
                    hl.FillOpacity = 1.0 -- Transparent fill
                    hl.OutlineOpacity = 0.5
                else
                    hl.FillColor = data.Color
                    hl.OutlineColor = Color3.fromRGB(255, 255, 255)
                    hl.FillOpacity = 0.4
                    hl.OutlineOpacity = 0.8
                end
                hl.Parent = inst

                -- Create BillboardGui
                local bill = Instance.new("BillboardGui")
                bill.AlwaysOnTop = true
                bill.Size = UDim2.new(0, 160, 0, 40)
                bill.StudsOffset = data.IsRoom and Vector3.new(0, 6, 0) or Vector3.new(0, 2.5, 0)
                bill.Adornee = inst
                bill.Parent = espGui

                local label = Instance.new("TextLabel")
                label.Size = UDim2.new(1, 0, 1, 0)
                label.BackgroundTransparency = 1
                label.TextColor3 = data.Color
                label.TextSize = espTextSize
                label.Font = Enum.Font.GothamBold
                label.TextStrokeTransparency = 0
                label.TextStrokeColor3 = Color3.fromRGB(0, 0, 0)
                label.Parent = bill

                activeEsps[inst] = {
                    Highlight = hl,
                    Billboard = bill,
                    Label = label
                }
                esp = activeEsps[inst]
            end

            -- Update Distance & Label
            esp.Label.Text = string.format("%s\n[%d studs]", data.Name, math.round(data.Distance))
            esp.Label.TextSize = espTextSize
        end
    end
end


