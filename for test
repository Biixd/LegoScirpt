local function getTemperature(zone)
    for _, object in ipairs(zone:GetDescendants()) do
        if (object:IsA("NumberValue") or object:IsA("IntValue")) and string.find(string.lower(object.Name), "temperature") then
            return object.Value
        end
    end
    return nil
end

local function updateColdestRoom(localPosition)
    local zones = child(map(), "Zones")
    if not zones then
        destroyESP("coldest-room")
        updateEvidence("Freezing Temp", false)
        return
    end
    local coldestRoom
    local coldestTemp = math.huge
    local freezing = false
    for _, zone in ipairs(zones:GetChildren()) do
        local temperature = getTemperature(zone)
        if temperature then
            if temperature < 0 then freezing = true end
            if temperature < coldestTemp then coldestTemp = temperature; coldestRoom = zone end
        end
    end
    updateEvidence("Freezing Temp", freezing)
    alertOnce("freezing", freezing, "เจอหลักฐาน", "ตรวจพบ Freezing Temperature")
    if Options.ColdestRoomESP.Value and coldestRoom then
        local color = coldestTemp < 0 and Colors.Freezing or Colors.ColdRoom
        local text = string.format("[%sm] %s (%.1f)", getDistanceText(localPosition, coldestRoom), coldestRoom.Name, coldestTemp)
        setESP("coldest-room", coldestRoom, text, color)
    else
        destroyESP("coldest-room")
    end
end

local function updateEMF(localPosition)
    local items = child(map(), "Items")
    local emfItem = items and items:FindFirstChild("EMF Reader")
    local level = 0
    if emfItem then
        for i = 5, 1, -1 do
            local levelFolder = emfItem:FindFirstChild(tostring(i))
            if levelFolder then
                for _, desc in ipairs(levelFolder:GetDescendants()) do
                    if desc:IsA("BasePart") and desc.Material == Enum.Material.Neon then level = i; break end
                end
            end
            if level > 0 then break end
        end
    end
    if Options.EMFReaderESP.Value and emfItem and level > 0 then
        local color = level == 5 and Colors.Ghost or (level >= 3 and Colors.Generator or Colors.EMF)
        setESP("emf-reader", emfItem, "[" .. getDistanceText(localPosition, emfItem) .. "m] EMF Lv." .. level, color)
    else
        destroyESP("emf-reader")
    end
    local emf5 = level == 5
    updateEvidence("EMF Level 5", emf5)
    alertOnce("emf5", emf5, "เจอหลักฐาน", "ตรวจพบ EMF Level 5")
end

local function getClosestRoomName(position)
    local zones = child(map(), "Zones")
    if not zones or not position then return "Unknown" end
    local closestName = "Unknown"
    local closestDistance = math.huge
    for _, zone in ipairs(zones:GetChildren()) do
        local zonePosition = getPosition(zone)
        if zonePosition then
            local distance = (position - zonePosition).Magnitude
            if distance < closestDistance then closestDistance = distance; closestName = zone.Name end
        end
    end
    return closestName
end

