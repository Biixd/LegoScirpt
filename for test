-- WalkSpeed loop
local humConnection
local function applyWalkSpeedLoop()
    if humConnection then humConnection:Disconnect() end
    
    local function hookHumanoid(char)
        local hum = char:WaitForChild("Humanoid", 5)
        if hum then
            humConnection = hum:GetPropertyChangedSignal("WalkSpeed"):Connect(function()
                if speedHackEnabled and hum.WalkSpeed ~= customWalkSpeed then
                    hum.WalkSpeed = customWalkSpeed
                elseif not speedHackEnabled and hum.WalkSpeed == customWalkSpeed then
                    hum.WalkSpeed = originalWalkSpeed
                end
            end)
            if speedHackEnabled then
                originalWalkSpeed = 16
                hum.WalkSpeed = customWalkSpeed
            end
        end
    end
    
    if LocalPlayer.Character then
        hookHumanoid(LocalPlayer.Character)
    end
    LocalPlayer.CharacterAdded:Connect(hookHumanoid)
end

-- FullBright implementation
local brightLight = nil
local originalLightingSettings = {
    Ambient = Lighting.Ambient,
    OutdoorAmbient = Lighting.OutdoorAmbient,
    Brightness = Lighting.Brightness,
    FogEnd = Lighting.FogEnd
}

local function setFullBright(enable)
    if enable then
        -- Brighten Ambient
        Lighting.Ambient = Color3.fromRGB(255, 255, 255)
        Lighting.OutdoorAmbient = Color3.fromRGB(255, 255, 255)
        Lighting.Brightness = 2
        Lighting.FogEnd = 999999
        
        -- Spawn local point light on character head
        task.spawn(function()
            while toggles.FullBright do
                local char = LocalPlayer.Character
                local head = char and char:FindFirstChild("Head")
                if head then
                    if not brightLight or brightLight.Parent ~= head then
                        if brightLight then brightLight:Destroy() end
                        brightLight = Instance.new("PointLight")
                        brightLight.Range = 1000
                        brightLight.Brightness = 5
                        brightLight.Parent = head
                    end
                end
                task.wait(1)
            end
        end)
    else
        -- Restore Lighting
        Lighting.Ambient = originalLightingSettings.Ambient
        Lighting.OutdoorAmbient = originalLightingSettings.OutdoorAmbient
        Lighting.Brightness = originalLightingSettings.Brightness
        Lighting.FogEnd = originalLightingSettings.FogEnd
        
        if brightLight then
            brightLight:Destroy()
            brightLight = nil
        end
    end
end

