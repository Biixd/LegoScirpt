-- [[ MONITORING LOOP (Updates Sidebar & Alerts) ]]

task.spawn(function()
    while true do
        task.wait(0.2)
        local ok, err = pcall(function()
            -- 1. Lowest Room Temp & Freezing Temp Check
            local lowestRoom, lowestTemp = getLowestTempRoom()
            if lowestRoom then
                roomWidget.ValueLabel.Text = string.format("%s (%.1f°C)", lowestRoom.Name, lowestTemp)
                roomWidget.ValueLabel.TextColor3 = Color3.fromRGB(0, 195, 255)
                
                if lowestTemp < 0 then
                    freezingWidget.ValueLabel.Text = "✅ DETECTED"
                    freezingWidget.ValueLabel.TextColor3 = Color3.fromRGB(0, 255, 100)
                else
                    freezingWidget.ValueLabel.Text = "❌ No"
                    freezingWidget.ValueLabel.TextColor3 = Color3.fromRGB(255, 80, 80)
                end
            else
                roomWidget.ValueLabel.Text = "No rooms found"
                roomWidget.ValueLabel.TextColor3 = Color3.fromRGB(150, 150, 150)
                freezingWidget.ValueLabel.Text = "❌ No"
                freezingWidget.ValueLabel.TextColor3 = Color3.fromRGB(255, 80, 80)
            end

            -- 2. SLS Ghost
            local sls = Workspace:FindFirstChild("SLS_GHOST")
            if sls then
                slsWidget.ValueLabel.Text = "✅ DETECTED"
                slsWidget.ValueLabel.TextColor3 = Color3.fromRGB(0, 255, 100)
            else
                slsWidget.ValueLabel.Text = "❌ No"
                slsWidget.ValueLabel.TextColor3 = Color3.fromRGB(255, 80, 80)
            end

            -- 3. Ghost Orb
            local mapFolder = Workspace:FindFirstChild("Map")
            local orbsFolder = mapFolder and mapFolder:FindFirstChild("Orbs")
            local orbFound = false
            if orbsFolder then
                for _, child in ipairs(orbsFolder:GetChildren()) do
                    if child.Name == "OrbPart" or child:IsA("BasePart") then
                        orbFound = true
                        break
                    end
                end
            end
            if orbFound then
                orbWidget.ValueLabel.Text = "✅ DETECTED"
                orbWidget.ValueLabel.TextColor3 = Color3.fromRGB(0, 255, 100)
            else
                orbWidget.ValueLabel.Text = "❌ No"
                orbWidget.ValueLabel.TextColor3 = Color3.fromRGB(255, 80, 80)
            end

            -- 4. UV Prints Count & Change Alert
            local printsFolder = mapFolder and mapFolder:FindFirstChild("Prints")
            local uvFound = false
            local uvCount = 0
            if printsFolder then
                for _, child in ipairs(printsFolder:GetChildren()) do
                    if child.Name == "UV_Hand" or child.Name == "UV_FootL" or child.Name == "UV_FootR" then
                        uvFound = true
                        uvCount = uvCount + 1
                    end
                end
            end
            if uvFound then
                uvWidget.ValueLabel.Text = string.format("✅ DETECTED (%d)", uvCount)
                uvWidget.ValueLabel.TextColor3 = Color3.fromRGB(0, 255, 100)
                
                -- Notification on new print
                if uvCount > lastUvCount then
                    Notification.new({
                        Title = "ร่องรอยคราบผี (UV Print)",
                        Description = "พบรอยมือหรือรอยเท้าผีอันใหม่ในแมพ!",
                        Duration = 4,
                        Icon = "rbxassetid://8997385628"
                    })
                end
            else
                uvWidget.ValueLabel.Text = "❌ No"
                uvWidget.ValueLabel.TextColor3 = Color3.fromRGB(255, 80, 80)
            end
            lastUvCount = uvCount

            -- 5. Ghost Writing
            local books = findGhostWritingBooks()
            local writingFound = false
            local writtenName = ""
            for _, book in ipairs(books) do
                local written, name = isBookWritten(book)
                if written then
                    writingFound = true
                    writtenName = name
                    break
                end
            end
            if writingFound then
                writingWidget.ValueLabel.Text = "✅ DETECTED"
                writingWidget.ValueLabel.TextColor3 = Color3.fromRGB(0, 255, 100)
            else
                writingWidget.ValueLabel.Text = "❌ No"
                writingWidget.ValueLabel.TextColor3 = Color3.fromRGB(255, 80, 80)
            end

            -- 6. EMF level monitor
            local emfVal = getEMFLevel()
            emfWidget.ValueLabel.Text = "Level " .. tostring(emfVal)
            if emfVal == 5 then
                emfWidget.ValueLabel.TextColor3 = Color3.fromRGB(255, 0, 50)
                if lastEmfLevel < 5 then
                    Notification.new({
                        Title = "🚨 EMF Level 5!",
                        Description = "ตรวจพบ EMF ระดับ 5 แล้ว (หลักฐานสำคัญ)!",
                        Duration = 5,
                        Icon = "rbxassetid://8997385628"
                    })
                end
            elseif emfVal >= 3 then
                emfWidget.ValueLabel.TextColor3 = Color3.fromRGB(255, 150, 0)
            else
                emfWidget.ValueLabel.TextColor3 = Color3.fromRGB(250, 250, 250)
            end
            lastEmfLevel = emfVal

            -- 7. Salt warning
            local salt = Workspace:FindFirstChild("SaltStepped")
            if salt then
                saltWidget.ValueLabel.Text = "⚠️ STEPPED"
                saltWidget.ValueLabel.TextColor3 = Color3.fromRGB(255, 150, 0)
                
