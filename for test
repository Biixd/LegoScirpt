                    saltAlreadyNotified = true
                end
            else
                saltWidget.ValueLabel.Text = "❌ No"
                saltWidget.ValueLabel.TextColor3 = Color3.fromRGB(255, 80, 80)
                saltAlreadyNotified = false
            end

            -- 8. Run ESP Frame update
            updateESP()
        end)
        if not ok then
            warn("Ghost helper loop error: " .. tostring(err))
        end
    end
end)

