local function updatePlayers(localPosition)
    if not Config.PlayerESP then
        destroyESPWithPrefix("player:")
        return
    end

    local alive = {}
    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer and player.Character then
            local allowed = Config.SelectedPlayer == "All" or Config.SelectedPlayer == player.Name
            local id = "player:" .. player.UserId
            alive[id] = true
            if allowed then
                local distance = getDistanceText(localPosition, player.Character)
                setESP(id, player.Character, "[" .. distance .. "m] " .. player.Name, Colors.Player)
            else
                destroyESP(id)
            end
        end
    end

    for id in pairs(ESP) do
        if string.sub(id, 1, 7) == "player:" and not alive[id] then
            destroyESP(id)
        end
    end
end

local function updateGhost(localPosition)
    local ghost = workspace:FindFirstChild("Ghost")
    updateGhostSpeed(ghost)

    if Config.GhostESP and ghost then
        setESP("ghost", ghost, "[" .. getDistanceText(localPosition, ghost) .. "m] GHOST", Colors.Ghost)
    else
        destroyESP("ghost")
    end

    alertOnce("ghost", ghost ~= nil, "ผีเกิดแล้ว", "พบ workspace.Ghost")
    return ghost
end

local function updateSLS(localPosition)
    local slsGhost = workspace:FindFirstChild("SLS_GHOST")
    if Config.SLSGhostESP and slsGhost then
        setESP("sls-ghost", slsGhost, "[" .. getDistanceText(localPosition, slsGhost) .. "m] SLS_GHOST", Colors.SLS)
