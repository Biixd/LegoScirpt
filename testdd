local function updateCursed(localPosition)
    local mapObject = map()
    local containers = {workspace}
    if mapObject then
        table.insert(containers, mapObject)
        local items = child(mapObject, "Items")
        local cursedSpawns = child(mapObject, "CursedSpawns")
        if items then table.insert(containers, items) end
        if cursedSpawns then table.insert(containers, cursedSpawns) end
    end

    for _, definition in ipairs(CurseDefs) do
        if Config[definition.Key] then
            local object = findItemInContainers(definition.Names, containers)
            if object then
                setESP(definition.Id, object, "[" .. getDistanceText(localPosition, object) .. "m] " .. definition.Label, definition.Color)
            else
                destroyESP(definition.Id)
            end
        else
            destroyESP(definition.Id)
        end
    end
end

local function cleanupInvalidESP()
    for id, entry in pairs(ESP) do
        if not entry.Object or not entry.Object.Parent or not entry.Object:IsDescendantOf(workspace) then
            destroyESP(id)
        end
    end
end

-- ==========================================
-- HEARTBEAT LOOP
-- ==========================================

local accum = {
    fast = 0,
    normal = 0,
    slow = 0,
    cleanup = 0,
    proximity = 0
}

connect(RunService.Heartbeat, function(dt)
    if not Running then return end

    accum.fast = accum.fast + dt
    accum.normal = accum.normal + dt
    accum.slow = accum.slow + dt
    accum.cleanup = accum.cleanup + dt
    accum.proximity = accum.proximity + dt

    if accum.fast >= 0.18 then
        accum.fast = 0
        local root = getLocalRoot()
        local localPosition = root and root.Position or nil
        updateGhost(localPosition)
        updateSLS(localPosition)
        updatePlayers(localPosition)
    end

    if accum.normal >= 0.75 then
        accum.normal = 0
        local root = getLocalRoot()
        local localPosition = root and root.Position or nil
        updateGenerators(localPosition)
        updateEMF(localPosition)
        updateOrb(localPosition)
        updateCursed(localPosition)
    end

    if accum.slow >= 1.5 then
        accum.slow = 0
        local root = getLocalRoot()
        local localPosition = root and root.Position or nil
        updateFullbright()
        updateColdestRoom(localPosition)
        updateUV()
        updateSalt()
        updateWriting()
    end

    -- Proximity Prompts: update every 0.1s for instant feel
    if accum.proximity >= 0.1 then
        accum.proximity = 0
        local root = getLocalRoot()
        local localPosition = root and root.Position or nil
        updateProximityPrompts(localPosition)
    end

    if accum.cleanup >= 4 then
        accum.cleanup = 0
        cleanupInvalidESP()
    end
end)

