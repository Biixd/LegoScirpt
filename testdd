local ProximityAlertedKeys = {}

local function setProximityCard(def, distNum, localPosition)
    local entry = getOrCreateProximityCard(def.Id)
    entry.Frame.Visible = true
    entry.Frame.LayoutOrder = def.Priority
    entry.Icon.Text = def.Icon
    entry.Name.Text = def.Label
    entry.Name.TextColor3 = def.Color
    entry.Stroke.Color = def.Color
    entry.Bar.BackgroundColor3 = def.Color

    local distStr = tostring(math.floor(distNum)) .. "m"
    entry.Dist.Text = "ระยะห่าง " .. distStr
    entry.BadgeText.Text = distStr

    -- pulse color badge when very close (< 5 studs)
    if distNum < 5 then
        entry.Badge.BackgroundColor3 = def.Color
        entry.BadgeText.TextColor3 = Color3.new(0, 0, 0)
    else
        entry.Badge.BackgroundColor3 = Color3.fromRGB(20, 24, 32)
        entry.BadgeText.TextColor3 = Color3.new(1, 1, 1)
    end

    -- one-time alert when first entering range
    if not ProximityAlertedKeys[def.Id] then
        ProximityAlertedKeys[def.Id] = true
        notify("เข้าใกล้ " .. def.Label, "ระยะห่าง " .. distStr, 3)
    end

    entry.Visible = true
end

local function hideProximityCard(id)
    local entry = ProximityCardPool[id]
    if entry then
        entry.Frame.Visible = false
        entry.Visible = false
    end
    ProximityAlertedKeys[id] = nil
end

local function updateProximityPrompts(localPosition)
    local anyVisible = false

    if not Config.ProximityPrompts or not localPosition then
        for id in pairs(ProximityCardPool) do
            hideProximityCard(id)
        end
        ProximityContainer.Visible = false
        return
    end

    for _, def in ipairs(ProximityDefs) do
        local object = def.GetObject()
        local pos = object and getPosition(object)
        local dist = pos and (localPosition - pos).Magnitude or math.huge

        if dist <= Config.ProximityRadius then
            setProximityCard(def, dist, localPosition)
            anyVisible = true
        else
            hideProximityCard(def.Id)
        end
    end

    ProximityContainer.Visible = anyVisible
end

